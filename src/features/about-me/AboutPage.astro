---
import type { Locale } from '@/i18n/locale';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SocialLinks from '@/layouts/SocialLinks.astro';
import RepoStar from '@/layouts/RepoStar.astro';
import Journey from '@/features/about-me/components/Journey.astro';
import Mascot from '@/features/about-me/components/Mascot.astro';
import WalkRoute from '@/features/about-me/components/WalkRoute.astro';
import { findAllTimelineEntries } from '@/features/about-me/timeline-repository';
import { findContributions } from '@/features/about-me/contributions';
import { findSkillAreas } from '@/features/about-me/skills';
import { getTranslator } from '@/i18n/translator';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const translate = getTranslator(locale);

const timeline = await findAllTimelineEntries(locale);
const contributionStations = findContributions(locale).map((contribution) => ({
  title: contribution.claim,
  items: [contribution.detail],
  pose: contribution.pose,
}));
const skillStations = findSkillAreas(locale).map((area) => ({
  title: area.title,
  label: area.title,
  items: [area.summary],
  tags: area.technologies,
  pose: area.pose,
}));
---

<BaseLayout
  locale={locale}
  title={translate('site.title')}
  description={translate('about.metaDescription')}
  showFooterSocialLinks={false}
>
  <section class="hero reveal">
    <div>
      <h1 class="statement">{translate('about.heroStatement')}</h1>
      <p class="hero-role">{translate('about.heroRole')}</p>
      <p class="lead hero-intro">{translate('about.heroIntro')}</p>
      <div class="hero-links">
        <SocialLinks />
        <p class="hero-projects">
          <a
            class="projects-link"
            href="https://github.com/nicovegasr"
            target="_blank"
            rel="noopener noreferrer"
          >
            {translate('about.projectsLink')}<span aria-hidden="true">&nbsp;↗</span>
          </a>
          <RepoStar locale={locale} showPrompt={false} class="hero-stars" />
        </p>
      </div>
    </div>
    <img
      class="hero-portrait"
      src="/nicolas-vegas.webp"
      width="480"
      height="480"
      loading="eager"
      alt={translate('about.portraitAlt')}
    />
  </section>

  <div class="walkway" data-walkway>
    <span class="thread" data-walkway-thread aria-hidden="true"></span>
    <Mascot class="page-walker" data-page-walker />

    <WalkRoute
      title={translate('about.contributionsTitle')}
      stations={contributionStations}
      direction="left"
      titleSize="medium"
    />

    <section>
      <h2 class="section-title">{translate('about.timelineTitle')}</h2>
      <Journey entries={timeline} />
    </section>

    <WalkRoute
      title={translate('about.skillsTitle')}
      stations={skillStations}
      direction="right"
      titleSize="large"
    />
  </div>
</BaseLayout>

<script>
  import '@/features/about-me/components/mascot-journey';
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 16rem;
    align-items: end;
    gap: var(--space-12);
  }

  .statement {
    font-size: clamp(3rem, 7.5vw, 5.5rem);
    letter-spacing: -0.03em;
    line-height: 1.08;
  }

  .hero-role {
    margin-top: var(--space-3);
    font-family: var(--font-family-display);
    font-size: var(--font-size-lead);
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-ink);
  }

  .hero-intro {
    margin-top: var(--space-3);
    max-width: 34rem;
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-6);
    margin-top: var(--space-6);
  }

  /* Un enlace de texto discreto, no un botón: mismo subrayado que el resto de enlaces secundarios. */
  .hero-projects {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-3);
    margin: 0;
  }

  .projects-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-text-soft);
    font-size: var(--font-size-small);
    line-height: 1.5;
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .projects-link:focus-visible {
    color: var(--color-ink);
    text-decoration-thickness: 3px;
  }

  @media (hover: hover) {
    .projects-link:hover {
      color: var(--color-ink);
      text-decoration-thickness: 3px;
    }
  }

  .hero-projects :global(.hero-stars) {
    margin-top: 0;
  }

  .hero-portrait {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-large);
  }

  .walkway {
    position: relative;
  }

  .walkway > :global(section + section) {
    margin-top: var(--space-16);
  }

  .section-title {
    font-size: var(--font-size-heading-1);
  }

  .thread,
  .page-walker {
    display: none;
  }

  @media (max-width: 48rem) {
    /* En móvil la foto encabeza el hero: basta con el aire de la cabecera, sin el margen completo de la página. */
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
      margin-top: calc(var(--space-8) - var(--space-16));
    }

    .hero-links {
      gap: 0 var(--space-6);
      margin-top: var(--space-4);
    }

    .hero-portrait {
      order: -1;
      width: 8rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) and (min-height: 34rem) {
    /* El bloque de la animación va centrado en pantalla: se sube para no dejar un hueco bajo la cabecera. */
    :global(.js) .hero {
      position: relative;
      z-index: 1;
    }

    :global(.js) .walkway {
      /* mascot-journey.ts mide cuánto hay que apartar el hilo del borde para que la mascota quepa entera.
         El texto conserva al menos esta distancia al hilo. */
      --walk-line-inset: 0px;
      --walk-text-indent: max(var(--space-12), var(--walk-line-inset) + var(--space-6));
      margin-top: calc(var(--space-16) * -1 - max(0px, (100svh - 40rem) * 0.3));
    }

    :global(.js) .thread {
      position: absolute;
      left: var(--walk-line-inset);
      display: block;
      width: 2px;
      background: var(--color-rule);
    }

    :global(.js) .thread::before {
      content: '';
      display: block;
      height: 100%;
      background: var(--color-ink);
      transform: scaleY(var(--thread-progress, 0));
      transform-origin: top;
    }

    :global(.js) .page-walker {
      --walker-size: clamp(3.75rem, 15vh, 7.5rem);
      position: fixed;
      z-index: 5;
      top: 0;
      left: 0;
      display: block;
      width: var(--walker-size);
      height: var(--walker-size);
      pointer-events: none;
      will-change: transform;
    }

    /* El hilo baja por la izquierda: el título se aparta como los capítulos. */
    :global(.js) .section-title {
      padding-inline-start: var(--walk-text-indent);
    }
  }

  @media (prefers-reduced-motion: no-preference) and (min-height: 34rem) and (max-width: 48rem) {
    :global(.js) .page-walker {
      --walker-size: clamp(3rem, 10vh, 4.5rem);
    }

    :global(.js) .walkway {
      --walk-text-indent: max(var(--space-8), var(--walk-line-inset) + var(--space-6));
    }
  }
</style>
