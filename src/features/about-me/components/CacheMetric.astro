---
import type { Locale } from '@/i18n/locale';
interface Props { locale: Locale }
const { locale } = Astro.props;
const es = locale === 'es';
// Recalled approximate load-time result; the cache animation does not attribute the whole improvement to one technique.
---

<figure class="cache-metric" data-cache-metric data-phase="ready">
  <figcaption class="result">
    <span>{es ? 'Menos espera al cargar' : 'Less waiting for pages to load'}</span>
    <strong>≈10 s <span aria-hidden="true">→</span><span class="sr-only">{es ? 'a' : 'to'}</span> ≈2 s</strong>
  </figcaption>
  <svg class="tray" viewBox="0 0 360 150" role="img" aria-label={es ? 'Una respuesta guardada se reutiliza cuando vuelve la misma petición. Una respuesta nueva requiere trabajo. Esquema ilustrativo.' : 'A saved response is reused when the same request returns. A new response requires work. Illustrative diagram.'}>
    <path class="surface" d="M18 94 34 76h214l16 18v32H18Z" />
    <path class="outline" d="M18 94h246M34 76v18m214-18v18" />
    <g class="saved">
      <rect class="match" x="38" y="90" width="52" height="29" rx="3" />
      <circle cx="53" cy="104" r="3" /><circle cx="64" cy="104" r="3" /><circle cx="75" cy="104" r="3" />
    </g>
    <rect class="surface" x="100" y="90" width="64" height="29" rx="3" />
    <path class="pattern" d="M118 100h27m-27 9h27" />
    <rect class="surface" x="174" y="90" width="64" height="29" rx="3" />
    <path d="M195 97h7v7h-7zm11 0h7v7h-7zm-11 11h7v7h-7zm11 0h7v7h-7z" />
    <g class="incoming">
      <rect class="surface" x="38" y="7" width="52" height="29" rx="3" />
      <circle cx="53" cy="21" r="3" /><circle cx="64" cy="21" r="3" /><circle cx="75" cy="21" r="3" />
    </g>
    <g class="reused">
      <rect class="match" x="38" y="48" width="52" height="29" rx="3" />
      <circle cx="53" cy="62" r="3" /><circle cx="64" cy="62" r="3" /><circle cx="75" cy="62" r="3" />
    </g>
    <text class="reuse-label" x="108" y="66">{es ? 'Reutilizar' : 'Reuse'}</text>
    <g class="new-result">
      <path class="outline" d="M288 110V84q0-4 4-4h17m12 0h17q4 0 4 4v26q0 4-4 4h-46q-4 0-4-4Z" />
      <path class="pattern new-pattern" d="m301 103 29-23" />
      <path class="outline" d="m335 66 4-8m5 15 8-4m-27-7v-9" />
    </g>
    <text class="tray-label" x="141" y="146" text-anchor="middle">{es ? 'Resultados guardados' : 'Saved results'}</text>
  </svg>
</figure>

<script>
  import { trackCacheMetrics } from './cache-metric';
  document.addEventListener('astro:page-load', trackCacheMetrics);
  trackCacheMetrics();
</script>

<style>
  .cache-metric {
    display: grid;
    grid-template-columns: minmax(16rem, 0.9fr) minmax(0, 1.3fr);
    align-items: center;
    gap: var(--space-6);
    margin: var(--space-6) 0 0;
    color: var(--color-ink);
  }
  .result { text-align: center; }
  .result > span { display: block; font-size: var(--font-size-base); font-weight: 600; line-height: 1.3; }
  .result strong {
    display: block;
    margin-top: var(--space-2);
    font-family: var(--font-family-display);
    font-size: clamp(1.75rem, 3.6vw, 3.25rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .tray { display: block; width: 100%; max-height: 10rem; overflow: visible; fill: var(--color-ink); }
  .surface { fill: var(--color-paper); stroke: var(--color-ink); stroke-width: 1.5; }
  .outline { fill: none; stroke: var(--color-ink); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .pattern { fill: none; stroke: var(--color-ink); stroke-width: 4; stroke-linecap: square; }
  .match { fill: var(--color-accent); stroke: var(--color-ink); stroke-width: 1.5; }
  .saved circle, .reused circle { fill: var(--color-accent-ink); }
  .reuse-label, .tray-label { font-family: var(--font-family-body); font-size: 13px; }
  .reuse-label { font-weight: 500; }
  .tray-label { fill: var(--color-text-soft); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  @media (prefers-reduced-motion: no-preference) {
    .incoming, .reused, .reuse-label, .new-result { transition: opacity var(--motion-duration-base), transform var(--motion-duration-base) var(--motion-easing); }
    .cache-metric[data-phase='lookup'] .reused,
    .cache-metric[data-phase='build'] .reused,
    .cache-metric[data-phase='store'] .reused,
    .cache-metric[data-phase='lookup'] .reuse-label,
    .cache-metric[data-phase='build'] .reuse-label,
    .cache-metric[data-phase='store'] .reuse-label { opacity: 0; }
    .cache-metric[data-phase='build'] .incoming { transform: translate(250px, 65px); }
    .cache-metric[data-phase='store'] .incoming { transform: translateY(80px); opacity: 0; }
    .cache-metric[data-phase='reuse'] .reused { transform: translateY(-38px); }
    .cache-metric[data-phase='reuse'] .new-result,
    .cache-metric[data-phase='ready'] .new-result { opacity: 0.45; }
    .cache-metric[data-phase='build'] .new-pattern { stroke: var(--color-accent); }
  }
  @media (prefers-reduced-motion: no-preference) and (min-height: 34rem) {
    :global(.js) :global(.station) .cache-metric { visibility: hidden; }
    :global(.js) :global(.station.is-current) .cache-metric { visibility: visible; }
  }
  @media (max-width: 48rem) {
    .cache-metric { grid-template-columns: 1fr; gap: var(--space-2); margin-top: var(--space-4); }
    .result > span { font-size: var(--font-size-small); }
    .result strong { font-size: var(--font-size-heading-2); margin-top: var(--space-1); }
    .tray { max-height: 7rem; }
  }
  @media (max-width: 48rem) and (max-height: 44rem) {
    .cache-metric { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-2); }
    .result > span { font-size: 0.6875rem; }
    .result strong { font-size: clamp(0.9375rem, 4.4vw, 1.25rem); }
  }
</style>
