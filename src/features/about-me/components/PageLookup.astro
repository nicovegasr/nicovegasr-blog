---
import type { Locale } from '@/i18n/locale';

interface Props { locale: Locale }
const { locale } = Astro.props;
const es = locale === 'es';
// Measured with EXPLAIN (ANALYZE, BUFFERS) on PostgreSQL 18 with 10 million rows: 123,457 pages without an index;
// with one, three index levels plus one table page.
const PAGES_WITHOUT_INDEX = '+100K';
const PAGES_WITH_INDEX = 4;
const INDEX_LEVELS = PAGES_WITH_INDEX - 1;
const DRAWN_TABLE_PAGES = 21;
const TARGET_TABLE_PAGE = 13;
const ROWS_PER_PAGE = 4;
const TARGET_ROW = 2;
const MILLISECONDS_PER_TABLE_PAGE = 90;
const MILLISECONDS_PER_INDEX_LEVEL = 280;
const indexStartsAt = DRAWN_TABLE_PAGES * MILLISECONDS_PER_TABLE_PAGE + 350;
const targetPageAt = indexStartsAt + INDEX_LEVELS * MILLISECONDS_PER_INDEX_LEVEL;
const rows = Array.from({ length: ROWS_PER_PAGE }, (_, row) => row);
const tablePages = Array.from({ length: DRAWN_TABLE_PAGES }, (_, page) => page);
const indexLevels = Array.from({ length: INDEX_LEVELS }, (_, level) => level);
---

<figure class="page-lookup" style={`--index-levels: ${INDEX_LEVELS}; --table-pages: ${DRAWN_TABLE_PAGES};`}>
  <p class="result">
    <strong>{PAGES_WITHOUT_INDEX} <span aria-hidden="true">→</span><span class="sr-only">{es ? 'a' : 'to'}</span> {PAGES_WITH_INDEX}</strong>
    <span>{es ? 'páginas de PostgreSQL leídas para encontrar 1 fila entre 10 millones' : 'PostgreSQL pages read to find 1 row among 10 million'}</span>
  </p>
  <div class="lookups" aria-hidden="true">
    <div class="lookup headings">
      <span></span>
      <span class="heading index-heading">{es ? 'Índice' : 'Index'}</span>
      <span class="heading">{es ? 'Páginas de la tabla' : 'Table pages'}</span>
    </div>
    <div class="lookup">
      <span class="lookup-label">{es ? 'Sin índice' : 'No index'}</span>
      <span></span>
      <div class="table-pages">
        {tablePages.map((page) => (
          <span class="page is-read" style={`--read-delay: ${page * MILLISECONDS_PER_TABLE_PAGE}ms;`}>
            {rows.map(() => <span class="row" />)}
          </span>
        ))}
      </div>
    </div>
    <div class="lookup">
      <span class="lookup-label">{es ? 'Con índice' : 'With index'}</span>
      <div class="index-levels">
        {indexLevels.map((level) => (
          <span class="page is-found" style={`--read-delay: ${indexStartsAt + level * MILLISECONDS_PER_INDEX_LEVEL}ms;`}>
            {rows.map(() => <span class="row" />)}
          </span>
        ))}
      </div>
      <div class="table-pages">
        {tablePages.map((page) => (
          <span class:list={['page', { 'is-found': page === TARGET_TABLE_PAGE }]} style={`--read-delay: ${targetPageAt}ms;`}>
            {rows.map((row) => <span class:list={['row', { 'is-target': page === TARGET_TABLE_PAGE && row === TARGET_ROW }]} />)}
          </span>
        ))}
      </div>
    </div>
  </div>
  <figcaption class="sr-only">
    {es
      ? 'Sin índice, la consulta lee todas las páginas de la tabla. Con índice, recorre tres niveles del índice hasta la página donde está la fila, lee esa página y toma la fila dentro de ella.'
      : 'Without an index, the query reads every table page. With one, it walks three index levels to the page that holds the row, reads that page and takes the row from it.'}
  </figcaption>
</figure>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .page-lookup {
    --page-gap: 3px;
    --page-height: clamp(1.75rem, 4.4svh, 2.5rem);
    --index-width: 15%;
    display: grid;
    grid-template-columns: minmax(13rem, 0.9fr) minmax(0, 1.3fr);
    align-items: end;
    gap: var(--space-6);
    margin: var(--space-6) 0 0;
    color: var(--color-ink);
  }

  .result { margin: 0; }

  .result strong {
    display: block;
    font-family: var(--font-family-display);
    font-size: clamp(2rem, 3.9vw, var(--font-size-display));
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: var(--line-height-tight);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .result > span {
    display: block;
    margin-top: var(--space-1);
    font-size: var(--font-size-base);
    line-height: 1.3;
  }

  .lookups {
    display: grid;
    gap: var(--page-gap);
    min-width: 0;
  }

  .lookup {
    display: grid;
    grid-template-columns: 5.5rem var(--index-width) minmax(0, 1fr);
    align-items: center;
    column-gap: var(--space-2);
  }

  .lookup-label {
    font-size: var(--font-size-small);
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
  }

  .heading {
    color: var(--color-text-soft);
    font-size: var(--font-size-meta);
    line-height: 1.5;
    white-space: nowrap;
  }

  .index-levels,
  .table-pages {
    display: grid;
    gap: var(--page-gap);
    height: var(--page-height);
  }

  .index-levels { grid-template-columns: repeat(var(--index-levels), minmax(0, 1fr)); }
  .table-pages { grid-template-columns: repeat(var(--table-pages), minmax(0, 1fr)); }

  .page {
    display: grid;
    grid-auto-rows: 1fr;
    gap: 1px;
    padding: 1px;
    border: 1px solid var(--color-rule);
    border-radius: 2px;
  }

  .row {
    background: var(--color-rule);
  }

  .is-read { border-color: var(--color-ink); }
  .is-read .row { background: var(--color-ink); }
  .is-found { border-color: var(--color-ink); background: var(--color-accent); }
  .is-found .row { background: var(--color-accent); }
  .is-found .row.is-target { background: var(--color-ink); }

  @media (prefers-reduced-motion: no-preference) and (min-height: 34rem) {
    :global(.js) :global(.station) .page-lookup { visibility: hidden; }
    :global(.js) :global(.station.is-current) .page-lookup { visibility: visible; }

    /* First every page is read; then the index walks to one page, and the row appears inside it. */
    :global(.js) :global(.station:not(.is-current)) .page { border-color: var(--color-rule); background: transparent; }
    :global(.js) :global(.station:not(.is-current)) .row { background: var(--color-rule); }
    :global(.js) :global(.station.is-current) .page,
    :global(.js) :global(.station.is-current) .row {
      transition:
        background-color 80ms linear calc(450ms + var(--read-delay)),
        border-color 80ms linear calc(450ms + var(--read-delay));
    }
    :global(.js) :global(.station.is-current) .row.is-target {
      transition-delay: calc(900ms + var(--read-delay));
    }
  }

  @media (max-width: 48rem) {
    .page-lookup {
      --page-gap: 2px;
      --page-height: 1.125rem;
      grid-template-columns: 1fr;
      gap: var(--space-2);
      margin-top: var(--space-4);
    }

    .result strong { font-size: var(--font-size-heading-1); }
    .result > span { font-size: var(--font-size-small); }
    .lookup { grid-template-columns: 4.25rem var(--index-width) minmax(0, 1fr); column-gap: var(--space-1); }
    .lookup-label { font-size: var(--font-size-meta); }
    .heading { font-size: 0.625rem; }
    .page { padding: 0; border-width: 1px; }
    .page .row:nth-child(even) { display: none; }
  }

  @media (max-width: 48rem) and (max-height: 44rem) {
    .page-lookup { --page-height: 0.75rem; gap: var(--space-1); margin-top: var(--space-2); }
    .result strong { font-size: clamp(1.125rem, 6vw, var(--font-size-heading-2)); }
    .result > span { margin-top: 0; font-size: 0.625rem; line-height: 1.2; }
    .lookup-label { font-size: 0.625rem; line-height: 1; }
  }
</style>
