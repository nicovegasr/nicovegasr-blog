---
import TimelineEntry from '@/features/about-me/components/TimelineEntry.astro';
import type { TimelineEntry as TimelineEntryModel } from '@/features/about-me/timeline-entry';

interface Props {
  entries: readonly TimelineEntryModel[];
}

const { entries } = Astro.props;
---

<div class="journey" data-journey>
  <span class="rail" aria-hidden="true"><span class="rail-fill"></span></span>
  <span class="traveller" aria-hidden="true"></span>
  <ol class="stops">
    {
      entries.map((entry) => (
        <li>
          <TimelineEntry entry={entry} />
        </li>
      ))
    }
  </ol>
</div>

<script>
  // Altura del viewport a la que el hilo "llega": lo que queda por debajo aún está por contar.
  const REACH_LINE_RATIO = 0.65;

  let stopTracking: AbortController | undefined;

  const trackJourney = () => {
    stopTracking?.abort();
    const journey = document.querySelector<HTMLElement>('[data-journey]');
    if (journey === null) {
      return;
    }
    const stops = journey.querySelectorAll<HTMLElement>('[data-journey-stop]');

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      journey.style.setProperty('--journey-progress', '1');
      journey.style.setProperty('--journey-tip', `${journey.offsetHeight}px`);
      stops.forEach((stop) => stop.classList.add('is-reached'));
      return;
    }

    let frame = 0;
    const paint = () => {
      frame = 0;
      const { top, height } = journey.getBoundingClientRect();
      const reachLine = window.innerHeight * REACH_LINE_RATIO;
      const atPageEnd =
        window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
      const tip = atPageEnd ? height : Math.min(Math.max(reachLine - top, 0), height);

      journey.style.setProperty('--journey-progress', String(tip / height));
      journey.style.setProperty('--journey-tip', `${tip}px`);
      stops.forEach((stop) => {
        stop.classList.toggle(
          'is-reached',
          atPageEnd || stop.getBoundingClientRect().top <= reachLine,
        );
      });
    };
    const requestPaint = () => {
      frame ||= requestAnimationFrame(paint);
    };

    stopTracking = new AbortController();
    const { signal } = stopTracking;
    window.addEventListener('scroll', requestPaint, { passive: true, signal });
    window.addEventListener('resize', requestPaint, { passive: true, signal });
    paint();
  };

  document.addEventListener('astro:page-load', trackJourney);
  trackJourney();
</script>

<style>
  .journey {
    --journey-progress: 0;
    --journey-tip: 0px;
    position: relative;
    margin-top: var(--space-12);
  }

  .stops {
    list-style: none;
    padding: 0;
  }

  .rail {
    position: absolute;
    inset: 0 auto 0 0;
    width: 2px;
    background: var(--color-rule);
  }

  .rail-fill {
    display: block;
    height: 100%;
    background: var(--color-ink);
    transform: scaleY(var(--journey-progress));
    transform-origin: top;
  }

  .traveller {
    position: absolute;
    z-index: 1;
    top: -9px;
    left: -9px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--color-accent);
    border: 2px solid var(--color-ink);
    /* Aparece al echar a andar: en reposo taparía la primera parada. */
    opacity: min(1, calc(var(--journey-progress) * 40));
    transform: translateY(var(--journey-tip));
    will-change: transform;
  }

  :global(html:not(.js)) .traveller,
  :global(html:not(.js)) .rail-fill {
    display: none;
  }

  :global(html:not(.js)) .rail {
    background: var(--color-ink);
  }
</style>
