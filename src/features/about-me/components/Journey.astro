---
import TimelineEntry from '@/features/about-me/components/TimelineEntry.astro';
import type { TimelineEntry as TimelineEntryModel } from '@/features/about-me/timeline-entry';

interface Props {
  entries: readonly TimelineEntryModel[];
}

const { entries } = Astro.props;
---

<div class="journey" data-journey>
  <span class="rail" aria-hidden="true"></span>
  <ol class="stops">
    {
      entries.map((entry) => (
        <li>
          <TimelineEntry entry={entry} />
        </li>
      ))
    }
  </ol>
</div>

<style>
  .journey {
    position: relative;
    margin-top: var(--space-12);
  }

  .stops {
    list-style: none;
    padding: 0;
  }

  .rail {
    position: absolute;
    inset: 0 auto 0 0;
    width: 2px;
    background: var(--color-ink);
  }

  /* Con la animación activa, el hilo continuo de la página sustituye a este tramo. */
  @media (prefers-reduced-motion: no-preference) and (min-height: 34rem) {
    :global(.js) .rail {
      display: none;
    }
  }
</style>
