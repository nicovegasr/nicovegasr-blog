---
import type { Locale } from '@/i18n/locale';
import claudeMark from '@/features/about-me/assets/claude-mark.svg?raw';
import codexMark from '@/features/about-me/assets/codex-mark.svg?raw';

interface Props { locale: Locale }
const { locale } = Astro.props;
const es = locale === 'es';
const LANE_COLUMNS = 18;
const MILLISECONDS_PER_BLOCK = 110;
// Illustrative amounts of work; only the two agents and the single review are literal.
const agents = [
  { name: 'Claude Code', mark: claudeMark, blocks: 18 },
  { name: 'Codex', mark: codexMark, blocks: 14 },
];
const reviewDelay = Math.max(...agents.map(({ blocks }) => blocks)) * MILLISECONDS_PER_BLOCK + 300;
---

<figure class="agent-review" style={`--lane-columns: ${LANE_COLUMNS}; --review-delay: ${reviewDelay}ms;`}>
  <p class="result">
    <strong>{es ? 'Guardarraíles' : 'Guardrails'}</strong>
    <span>{es ? 'en la memoria de cada agente, no solo en un repositorio' : "in every agent's memory, not just in one repository"}</span>
  </p>
  <div class="work" aria-hidden="true">
    <span class="gate rules">{es ? 'Mis reglas' : 'My rules'}</span>
    {agents.map(({ name, mark, blocks }, agentIndex) => (
      <>
        <span class="agent" style={`grid-row: ${agentIndex + 1};`}>
          <span class="agent-mark" set:html={mark} />
          {name}
        </span>
        <div class="lane" style={`grid-row: ${agentIndex + 1};`}>
          {Array.from({ length: blocks }, (_, column) => (
            <span class="block" style={`--fill-delay: ${column * MILLISECONDS_PER_BLOCK}ms;`} />
          ))}
        </div>
      </>
    ))}
    <span class="gate review">{es ? 'Mi revisión' : 'My review'}</span>
  </div>
  <figcaption class="sr-only">
    {es
      ? 'Esquema ilustrativo: Claude Code y Codex parten de mis reglas, trabajan a la vez y su trabajo termina en mi revisión.'
      : 'Illustrative diagram: Claude Code and Codex start from my rules, work at the same time and their work ends in my review.'}
  </figcaption>
</figure>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .agent-review {
    --block-gap: 3px;
    --block-height: clamp(1.75rem, 4.8svh, 2.75rem);
    display: grid;
    grid-template-columns: minmax(13rem, 0.9fr) minmax(0, 1.3fr);
    align-items: end;
    gap: var(--space-6);
    margin: var(--space-6) 0 0;
    color: var(--color-ink);
  }

  .result { margin: 0; }

  .result strong {
    display: block;
    font-family: var(--font-family-display);
    font-size: clamp(2rem, 3.9vw, var(--font-size-display));
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: var(--line-height-tight);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .result > span {
    display: block;
    margin-top: var(--space-1);
    font-size: var(--font-size-base);
    line-height: 1.3;
  }

  .work {
    display: grid;
    grid-template-columns: 4.25rem 7rem minmax(0, 1fr) 4.25rem;
    align-items: center;
    column-gap: var(--space-2);
    row-gap: var(--block-gap);
    min-width: 0;
  }

  .agent {
    grid-column: 2;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-small);
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
  }

  .agent-mark {
    display: block;
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
  }

  .agent-mark :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .lane {
    grid-column: 3;
    display: grid;
    grid-template-columns: repeat(var(--lane-columns), minmax(0, 1fr));
    gap: var(--block-gap);
    height: var(--block-height);
  }

  .block {
    border: 1px solid var(--color-ink);
    border-radius: 2px;
    background: var(--color-ink);
  }

  .gate {
    grid-row: 1 / span 2;
    align-self: stretch;
    display: grid;
    place-items: center;
    padding: var(--space-1);
    border: 1px solid var(--color-ink);
    border-radius: 2px;
    color: var(--color-accent-ink);
    background: var(--color-accent);
    font-size: var(--font-size-meta);
    font-weight: 600;
    line-height: 1.15;
    text-align: center;
  }

  .rules { grid-column: 1; }
  .review { grid-column: 4; }

  @media (prefers-reduced-motion: no-preference) and (min-height: 34rem) {
    :global(.js) :global(.station) .agent-review { visibility: hidden; }
    :global(.js) :global(.station.is-current) .agent-review { visibility: visible; }

    /* The rules come first, both agents advance at once, and nothing is finished until the review appears. */
    :global(.js) :global(.station:not(.is-current)) .block,
    :global(.js) :global(.station:not(.is-current)) .gate { opacity: 0; }
    :global(.js) :global(.station.is-current) .rules {
      transition: opacity var(--motion-duration-fast) var(--motion-easing) 300ms;
    }
    :global(.js) :global(.station.is-current) .block {
      transition: opacity 80ms linear calc(800ms + var(--fill-delay));
    }
    :global(.js) :global(.station.is-current) .review {
      transition: opacity var(--motion-duration-fast) var(--motion-easing) calc(800ms + var(--review-delay));
    }
  }

  @media (max-width: 48rem) {
    .agent-review {
      --block-gap: 2px;
      --block-height: 1.25rem;
      grid-template-columns: 1fr;
      gap: var(--space-2);
      margin-top: var(--space-4);
    }

    .result strong { font-size: var(--font-size-heading-1); }
    .result > span { font-size: var(--font-size-small); }
    .work { grid-template-columns: 3rem 1rem minmax(0, 1fr) 3rem; column-gap: var(--space-1); }
    .agent { font-size: 0; }
    .agent-mark { width: 0.875rem; height: 0.875rem; }
    .gate { padding: 0.125rem; font-size: 0.625rem; }
  }

  @media (max-width: 48rem) and (max-height: 44rem) {
    .agent-review { --block-height: 0.875rem; gap: var(--space-1); margin-top: var(--space-2); }
    .result strong { font-size: clamp(1.125rem, 6vw, var(--font-size-heading-2)); }
    .result > span { margin-top: 0; font-size: var(--font-size-meta); }
    .gate { font-size: 0.5625rem; }
  }
</style>
