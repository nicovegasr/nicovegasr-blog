---
import type { Locale } from '@/i18n/locale';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const es = locale === 'es';
const COLUMNS_PER_SECOND = 2;
const TIMELINE_COLUMNS = 10 * COLUMNS_PER_SECOND;
const MILLISECONDS_PER_BLOCK = 70;
const PAUSE_BETWEEN_VISITS = 250;
// Blocks keep the proportion of the recalled result; they are not a measurement of each visit.
const visits = [
  { label: es ? 'Primera visita' : 'First visit', blocks: 10 * COLUMNS_PER_SECOND, isFirst: true },
  { label: es ? 'Segunda visita' : 'Second visit', blocks: 2 * COLUMNS_PER_SECOND, isFirst: false },
  { label: es ? 'Tercera visita' : 'Third visit', blocks: 2 * COLUMNS_PER_SECOND, isFirst: false },
];
const startOfVisit = (visitIndex: number): number =>
  visits
    .slice(0, visitIndex)
    .reduce((elapsed, { blocks }) => elapsed + blocks * MILLISECONDS_PER_BLOCK + PAUSE_BETWEEN_VISITS, 0);
---

<figure class="load-waterfall" style={`--timeline-columns: ${TIMELINE_COLUMNS};`}>
  <p class="result">
    <strong>
      ≈10 s <span aria-hidden="true">→</span>
      <span class="sr-only">{es ? 'a' : 'to'}</span> ≈2 s
    </strong>
    <span>{es ? 'menos espera al cargar' : 'less waiting for pages to load'}</span>
  </p>
  <div class="visits" aria-hidden="true">
    {visits.map(({ label, blocks, isFirst }, visitIndex) => (
      <div class="visit">
        <span class="visit-label">{label}</span>
        <div class="lane">
          {Array.from({ length: blocks }, (_, column) => (
            <span
              class:list={['block', { 'is-first-visit': isFirst }]}
              style={`--fill-delay: ${startOfVisit(visitIndex) + column * MILLISECONDS_PER_BLOCK}ms;`}
            />
          ))}
        </div>
      </div>
    ))}
  </div>
  <figcaption class="sr-only">
    {es
      ? 'Esquema ilustrativo: la primera visita a una pantalla espera a que se resuelvan sus peticiones; las siguientes reutilizan las respuestas guardadas y tardan menos.'
      : 'Illustrative diagram: the first visit to a screen waits for its requests; later visits reuse the saved responses and take less time.'}
  </figcaption>
</figure>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .load-waterfall {
    --block-gap: 3px;
    --block-height: clamp(1.25rem, 3.4svh, 1.875rem);
    display: grid;
    grid-template-columns: minmax(13rem, 0.9fr) minmax(0, 1.3fr);
    align-items: end;
    gap: var(--space-6);
    margin: var(--space-6) 0 0;
    color: var(--color-ink);
  }

  .result {
    margin: 0;
  }

  .result strong {
    display: block;
    font-family: var(--font-family-display);
    font-size: clamp(2rem, 3.9vw, var(--font-size-display));
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: var(--line-height-tight);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .result > span {
    display: block;
    margin-top: var(--space-1);
    font-size: var(--font-size-base);
    line-height: 1.3;
  }

  .visits {
    display: grid;
    gap: var(--block-gap);
    min-width: 0;
  }

  .visit {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    align-items: center;
    column-gap: var(--space-3);
  }

  .visit-label {
    font-size: var(--font-size-small);
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
  }

  .lane {
    display: grid;
    grid-template-columns: repeat(var(--timeline-columns), minmax(0, 1fr));
    gap: var(--block-gap);
    height: var(--block-height);
  }

  .block {
    border: 1px solid var(--color-ink);
    border-radius: 2px;
    background: var(--color-accent);
  }

  .block.is-first-visit {
    background: var(--color-ink);
  }

  @media (prefers-reduced-motion: no-preference) and (min-height: 34rem) {
    :global(.js) :global(.station) .load-waterfall {
      visibility: hidden;
    }
    :global(.js) :global(.station.is-current) .load-waterfall {
      visibility: visible;
    }

    /* Each visit loads at the same pace, so the wait itself is what the reader sees. */
    :global(.js) :global(.station:not(.is-current)) .block {
      opacity: 0;
    }
    :global(.js) :global(.station.is-current) .block {
      transition: opacity 60ms linear calc(450ms + var(--fill-delay));
    }
  }

  @media (max-width: 48rem) {
    .load-waterfall {
      --block-gap: 2px;
      --block-height: 0.75rem;
      grid-template-columns: 1fr;
      gap: var(--space-2);
      margin-top: var(--space-4);
    }

    .result strong {
      font-size: var(--font-size-heading-1);
    }
    .result > span {
      font-size: var(--font-size-small);
    }
    .visit {
      grid-template-columns: 5.5rem minmax(0, 1fr);
      column-gap: var(--space-2);
    }
    .visit-label {
      font-size: var(--font-size-meta);
    }
  }

  @media (max-width: 48rem) and (max-height: 44rem) {
    .load-waterfall {
      --block-height: 0.5rem;
      gap: var(--space-1);
      margin-top: var(--space-2);
    }
    .result strong {
      font-size: clamp(1.125rem, 6vw, var(--font-size-heading-2));
    }
    .result > span {
      margin-top: 0;
      font-size: var(--font-size-meta);
    }
    .visit-label {
      font-size: 0.625rem;
      line-height: 1;
    }
  }
</style>
