---
import walkingAtlas from '@/shared/mascot/worker-walk-atlas.webp?url';
import reactionsAtlas from '@/shared/mascot/worker-reactions.webp?url';
import studentAtlas from '@/shared/mascot/age-2019.webp?url';
import laptopAtlas from '@/shared/mascot/age-2023.webp?url';
import tieAtlas from '@/shared/mascot/age-2024.webp?url';
import matureAtlas from '@/shared/mascot/age-2026.webp?url';
import matureReactionsAtlas from '@/shared/mascot/age-2026-reactions.webp?url';
import skillsAtlas from '@/shared/mascot/skills-glasses.webp?url';
import backendAtlas from '@/shared/mascot/skills-backend.webp?url';
import frontendAtlas from '@/shared/mascot/skills-frontend.webp?url';

const { class: className, ...attributes } = Astro.props;
const atlases = {
  original: { walking: walkingAtlas, reactions: reactionsAtlas },
  2019: { walking: studentAtlas, reactions: reactionsAtlas },
  2023: { walking: laptopAtlas, reactions: reactionsAtlas },
  2024: { walking: tieAtlas, reactions: reactionsAtlas },
  2026: { walking: matureAtlas, reactions: matureReactionsAtlas },
  skills: { walking: skillsAtlas, reactions: skillsAtlas, layout: '3x3' },
  backend: { walking: backendAtlas, reactions: backendAtlas, layout: '3x3' },
  frontend: { walking: frontendAtlas, reactions: frontendAtlas, layout: '3x3' },
};
const initialAtlasUrls = [walkingAtlas, reactionsAtlas];
---

{initialAtlasUrls.map((href) => <link rel="preload" as="image" href={href} media="(prefers-reduced-motion: no-preference) and (min-height: 34rem)" />)}
<span
  {...attributes}
  class:list={['mascot', className]}
  data-mascot-atlases={JSON.stringify(atlases)}
  data-mascot-age="original"
  style={`--walking-atlas: url(${walkingAtlas}); --reactions-atlas: url(${reactionsAtlas});`}
  aria-hidden="true"
></span>

<style>
  .mascot {
    --sprite-column: 0;
    --sprite-row: 1;
    --reaction-column: 2;
    --reaction-row: 1;
    --reaction-visibility: 0;
    --facing: 1;
    display: block;
  }

  .mascot.is-arrived {
    --reaction-visibility: 1;
  }

  .mascot::before,
  .mascot::after {
    content: '';
    position: absolute;
    inset: 0;
    background-repeat: no-repeat;
    background-size: 300% 200%;
    transform: scaleX(var(--facing));
  }

  .mascot::before {
    background-image: var(--walking-atlas);
    background-position: calc(var(--sprite-column) * 50%) calc(var(--sprite-row) * 100%);
    opacity: calc(1 - var(--reaction-visibility));
  }

  /* Las dos capas se cargan desde el principio para que las reacciones no parpadeen. */
  .mascot::after {
    background-image: var(--reactions-atlas);
    background-position: calc(var(--reaction-column) * 50%) calc(var(--reaction-row) * 100%);
    opacity: var(--reaction-visibility);
  }

  /* Skills sheets share walking/resting rows and a dedicated final reaction row. */
  .mascot[data-mascot-layout='3x3']::before,
  .mascot[data-mascot-layout='3x3']::after {
    background-size: 300% 300%;
  }

  .mascot[data-mascot-layout='3x3']::before {
    background-position: calc(var(--sprite-column) * 50%) calc(var(--sprite-row) * 50%);
  }

  .mascot[data-mascot-layout='3x3']::after {
    background-position: calc(var(--reaction-column) * 50%) 100%;
  }
</style>
