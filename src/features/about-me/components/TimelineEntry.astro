---
import type { TimelineEntry } from '@/features/about-me/timeline-entry';
import { getTranslator } from '@/i18n/translator';

interface Props {
  entry: TimelineEntry;
}

const { entry } = Astro.props;
const translate = getTranslator(entry.locale);

const formatMonthYear = (date: Date): string =>
  new Intl.DateTimeFormat(entry.locale, { month: 'short', year: 'numeric' }).format(date);

const startMachine = entry.startDate.toISOString().slice(0, 10);
const endMachine = entry.endDate?.toISOString().slice(0, 10);
const credit = [entry.organization, entry.role, entry.sector].filter(
  (part): part is string => part !== undefined,
);
---

<article class="timeline-entry" data-journey-stop data-start-year={entry.startDate.getUTCFullYear()}>
  <div class="when">
    <time class="year" datetime={startMachine}>{entry.startDate.getUTCFullYear()}</time>
    <span class="place">{entry.place}</span>
  </div>
  <div class="body">
    <h3>{entry.title}</h3>
    {entry.summary !== undefined && <p class="summary">{entry.summary}</p>}
    {
      entry.documentUrl !== undefined && (
        <p class="document">
          <a href={entry.documentUrl} target="_blank" rel="noopener noreferrer">
            {entry.documentLabel} →
          </a>
        </p>
      )
    }
    {
      entry.organization !== undefined && (
        <p class="credit">
          <span>{credit.join(' · ')}</span>
          <span class="period">
            <time datetime={startMachine}>{formatMonthYear(entry.startDate)}</time>
            {' – '}
            {entry.endDate === undefined ? (
              <span>{translate('about.present')}</span>
            ) : (
              <time datetime={endMachine}>{formatMonthYear(entry.endDate)}</time>
            )}
          </span>
        </p>
      )
    }
  </div>
</article>

<style>
  .timeline-entry {
    position: relative;
    display: grid;
    grid-template-columns: 13rem minmax(0, var(--content-width-reading));
    column-gap: var(--space-8);
    padding-left: var(--space-12);
    padding-bottom: var(--space-24);
  }

  .timeline-entry::before {
    content: '';
    position: absolute;
    left: -6px;
    top: 1.45rem;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--color-paper);
    border: 2px solid var(--color-ink);
    transition: background var(--motion-duration-reading) var(--motion-easing);
  }

  .timeline-entry.is-reached::before {
    background: var(--color-ink);
  }

  .year {
    display: inline-block;
    padding-inline: 0.12em;
    margin-inline-start: -0.12em;
    font-family: var(--font-family-display);
    font-size: var(--font-size-display);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.03em;
    line-height: 1.05;
    background: linear-gradient(var(--color-accent), var(--color-accent)) no-repeat left center / 0% 100%;
    transition:
      background-size var(--motion-duration-reading) var(--motion-easing),
      color var(--motion-duration-reading) var(--motion-easing);
  }

  /* El rotulador solo acompaña al capítulo que se está leyendo. */
  .timeline-entry.is-active .year {
    color: var(--color-accent-ink);
    background-size: 100% 100%;
  }

  .place {
    display: block;
    margin-top: var(--space-2);
    font-size: var(--font-size-small);
    color: var(--color-text-soft);
  }

  .body {
    padding-top: var(--space-2);
  }

  .body h3 {
    font-size: var(--font-size-heading-2);
    text-wrap: balance;
  }

  .summary {
    margin-top: var(--space-3);
    color: var(--color-text-soft);
  }

  .document {
    margin-top: var(--space-2);
    font-size: var(--font-size-small);
  }

  .credit {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1) var(--space-6);
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-rule);
    font-size: var(--font-size-small);
    line-height: 1.5;
    color: var(--color-text-soft);
  }

  .period {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* Solo con JS: sin él, todos los capítulos se leen desde el principio. */
  :global(.js) .when,
  :global(.js) .body {
    opacity: 0.3;
    transform: translateY(12px);
    transition:
      opacity var(--motion-duration-reading) var(--motion-easing),
      transform var(--motion-duration-reading) var(--motion-easing);
  }

  :global(.js) .timeline-entry.is-reached .when,
  :global(.js) .timeline-entry.is-reached .body {
    opacity: 1;
    transform: none;
  }

  /* Con la animación, el punto sigue al hilo de la página y el texto guarda su distancia. */
  @media (prefers-reduced-motion: no-preference) and (min-height: 34rem) {
    :global(.js) .timeline-entry {
      padding-left: var(--walk-text-indent, var(--space-12));
    }

    :global(.js) .timeline-entry::before {
      left: calc(var(--walk-line-inset, 0px) - 6px);
    }
  }

  @media (max-width: 48rem) {
    .timeline-entry {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-2);
      padding-left: var(--space-8);
      padding-bottom: var(--space-16);
    }

    .timeline-entry::before {
      top: 0.95rem;
    }

    .when {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: var(--space-1) var(--space-3);
    }

    .year {
      font-size: var(--font-size-heading-1);
    }

    .place {
      margin-top: 0;
    }

    .body {
      padding-top: 0;
    }
  }
</style>
