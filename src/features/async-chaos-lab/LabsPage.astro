---
import type { Locale } from '@/i18n/locale';
import ContentLayout from '@/layouts/ContentLayout.astro';
import { labPath } from './links';
import previewVideoEs from './assets/lab-preview-es.mp4?url';
import previewVideoEn from './assets/lab-preview-en.mp4?url';
import previewMobileVideoEs from './assets/lab-preview-mobile-es.mp4?url';
import previewMobileVideoEn from './assets/lab-preview-mobile-en.mp4?url';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const es = locale === 'es';
const title = es ? 'Laboratorios' : 'Labs';
const description = es
  ? 'Construye, experimenta y descubre cómo se comporta tu sistema.'
  : 'Build, experiment and discover how your system behaves.';
---

<ContentLayout locale={locale} title={title} description={description}>
  <header class="labs-heading">
    <p class="lead">
      {description}
    </p><p class="labs-note">
      {
        es
          ? 'Simulaciones interactivas. Sin registro ni instalaciones.'
          : 'Interactive simulations. No signup or installation.'
      }
    </p>
  </header>
  <a class="featured-lab" href={labPath(locale)}
    ><span class="label"
      >{
        es
          ? 'TRES EXPERIMENTOS · APRENDE ROMPIENDO'
          : 'THREE EXPERIMENTS · LEARN BY BREAKING'
      }</span
    ><h2>Async Chaos Lab →</h2><p>
      {
        es
          ? 'Evita perder pagos, protege los efectos de cada paso y aprende a escalar cuando llegan 24 de golpe. Mira lo que ocurre y cambia tu sistema sobre el diagrama.'
          : 'Keep payments safe, protect each step’s effects, and learn to scale when 24 arrive at once. Watch what happens and change your system on the diagram.'
      }
    </p><video
      class="lab-preview"
      autoplay
      muted
      loop
      playsinline
      aria-hidden="true"
      ><source
        media="(max-width: 640px)"
        src={es ? previewMobileVideoEs : previewMobileVideoEn}
        type="video/mp4"
      /><source src={es ? previewVideoEs : previewVideoEn} type="video/mp4" /></video
    ><b>{es ? 'Abrir el simulador' : 'Open the simulator'}</b></a
  >
</ContentLayout>
<style>
  .featured-lab {
    display: block;
    text-decoration: none;
    border: 2px solid var(--color-ink);
    box-shadow: 5px 5px 0 var(--color-ink);
    padding: var(--space-6);
    margin-bottom: var(--space-8);
  }
  .featured-lab h2 {
    font-size: var(--font-size-heading-1);
    margin-block: var(--space-2);
  }
  .featured-lab p {
    max-width: 65ch;
    font-size: var(--font-size-small);
  }
  .lab-preview {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2154 / 268;
    margin-top: var(--space-4);
  }
  @media (max-width: 640px) {
    .lab-preview {
      aspect-ratio: 962 / 268;
    }
  }
  .featured-lab b {
    display: inline-block;
    background: var(--color-accent);
    color: var(--color-accent-ink);
    padding: var(--space-2) var(--space-3);
    margin-top: var(--space-4);
  }
  .labs-heading {
    margin-bottom: var(--space-8);
  }
  .labs-heading .lead {
    max-width: 44ch;
  }
  .labs-note {
    font-size: var(--font-size-small);
    color: var(--color-text-soft);
  }
</style>
