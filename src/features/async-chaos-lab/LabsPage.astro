---
import type { Locale } from '@/i18n/locale';
import ContentLayout from '@/layouts/ContentLayout.astro';
import { buildLabPath } from '@/i18n/routes';
import { labPath } from './shared/links';
import AssemblyLinePreview from './catalogue-preview/AssemblyLinePreview.astro';
import MemoryTerminalPreview from '@/features/out-of-memory-lab/catalogue-preview/TerminalPreview.astro';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const es = locale === 'es';
const title = es ? 'Laboratorios' : 'Labs';
const description = es
  ? 'Construye, experimenta y descubre cómo se comporta tu sistema.'
  : 'Build, experiment and discover how your system behaves.';
---

<ContentLayout locale={locale} title={title} description={description} lead={description}>
  <a class="featured-lab" href={labPath(locale)}
    ><span class="label"
      >{
        es
          ? 'TRES EXPERIMENTOS · APRENDE ROMPIENDO'
          : 'THREE EXPERIMENTS · LEARN BY BREAKING'
      }</span
    ><h2>Async Chaos Lab →</h2><p>
      {
        es
          ? 'Evita perder pagos, protege los efectos de cada paso y aprende a escalar cuando llegan 24 de golpe. Mira lo que ocurre y cambia tu sistema sobre el diagrama.'
          : 'Keep payments safe, protect each step’s effects, and learn to scale when 24 arrive at once. Watch what happens and change your system on the diagram.'
      }
    </p><AssemblyLinePreview locale={locale} /><b>{es ? 'Abrir el simulador' : 'Open the simulator'}</b></a
  >
  {
    es && (
      <a class="featured-lab" href={buildLabPath(locale, 'exit-137')}
        ><span class="label">CUATRO RETOS · SIN QUEDARTE SIN MEMORIA</span><h2>Exit 137 →</h2><p>
          Monta un script que recorra meses de logs sin quedarse sin memoria.
        </p><MemoryTerminalPreview /><b>Abrir el laboratorio</b></a
      >
    )
  }
</ContentLayout>
<style>
  .featured-lab {
    display: block;
    text-decoration: none;
    border: 2px solid var(--color-ink);
    box-shadow: 5px 5px 0 var(--color-ink);
    padding: var(--space-6);
    margin-bottom: var(--space-8);
  }
  .featured-lab h2 {
    font-size: var(--font-size-heading-1);
    margin-block: var(--space-2);
  }
  .featured-lab p {
    max-width: 65ch;
    font-size: var(--font-size-small);
  }
  .featured-lab b {
    display: inline-block;
    background: var(--color-accent);
    color: var(--color-accent-ink);
    padding: var(--space-2) var(--space-3);
    margin-top: var(--space-4);
  }
</style>
