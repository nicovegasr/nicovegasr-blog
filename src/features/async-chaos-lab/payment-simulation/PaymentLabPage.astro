---
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Locale } from '@/i18n/locale';
import { labPath } from '../shared/links';
import LabHeader from '../shared/LabHeader.astro';
import '../shared/stories.css';
import './worker-actor.css';
interface Props {
  locale: Locale;
  level: 1 | 2;
  title: string;
}
const { locale, level, title } = Astro.props;
const es = locale === 'es';
---

<BaseLayout
  locale={locale}
  title={`${title} · Async Chaos Lab`}
  description={
    es
      ? 'Ponle tus nombres al sistema, ejecuta tres pagos y observa las consecuencias de cada decisión.'
      : 'Name your system, run three payments and see the consequences of each decision.'
  }
  alternatePaths={{ es: labPath('es', level), en: labPath('en', level) }}
>
  <LabHeader locale={locale} level={level} title={title} />
  <payment-lab data-level={level} data-locale={locale}></payment-lab>
  <noscript>
    {es ? 'Activa JavaScript para probar la simulación.' : 'Enable JavaScript to try the simulation.'}
  </noscript>
</BaseLayout>
