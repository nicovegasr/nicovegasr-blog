---
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Locale } from '@/i18n/locale';
import LabHeader from './LabHeader.astro';
import { labPath } from './links';
import './stories.css';
import './scaling/scaling.css';
interface Props { locale: Locale }
const { locale } = Astro.props;
const es = locale === 'es';
const title = es ? 'Tu sistema se queda pequeño.' : 'Your system is growing.';
---
<BaseLayout locale={locale} title={`${title} · Async Chaos Lab`}
  description={es ? '24 pagos. Un worker. Equilibra workers, plazas simultáneas y cuotas HTTP: espera por capacidad o descubre un rechazo 429.' : '24 payments. One worker. Balance workers, concurrent slots and HTTP quotas: wait for capacity or discover a 429 rejection.'}
  alternatePaths={{ es: labPath('es', 3), en: labPath('en', 3) }}>
  <LabHeader locale={locale} level={3} title={title} />
  <queue-scaling-game data-locale={locale}></queue-scaling-game>
  <noscript>{es ? 'Activa JavaScript para probar el laboratorio.' : 'Enable JavaScript to try the lab.'}</noscript>
</BaseLayout>
<script>import './scaling/controller';</script>
