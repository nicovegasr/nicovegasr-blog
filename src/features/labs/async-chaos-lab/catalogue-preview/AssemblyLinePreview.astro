---
import { assemblyLineCopy } from './assembly-line-copy';
import type { Locale } from '@/i18n/locale';
import walkAtlas from '@/shared/mascot/worker-walk-atlas.webp?url';
import reactionsAtlas from '@/shared/mascot/worker-reactions.webp?url';
import './assembly-line-preview.css';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const text = assemblyLineCopy(locale);
---

<assembly-line-preview
  class="assembly"
  aria-hidden="true"
  data-walk={walkAtlas}
  data-reactions={reactionsAtlas}
  data-fails={text.fails}
>
  <div class="assembly-score">
    <span>
      {text.paid}
      <b data-count="paid">0</b>
    </span>
    <span class="is-goal">
      {text.lost}
      <b>0</b>
    </span>
    <span class="is-goal">
      {text.duplicated}
      <b>0</b>
    </span>
    <span class="assembly-retries">
      {text.retries}
      <b data-count="retries">0</b>
    </span>
  </div>
  <div class="assembly-post assembly-api">
    API<small>{text.api}</small>
  </div>
  <div class="assembly-belt"></div>
  <div class="assembly-post assembly-queue">{text.queue}</div>
  <div class="assembly-desk" data-station="0"></div>
  <div class="assembly-desk" data-station="1"></div>
  <div class="assembly-desk" data-station="2"></div>
  <div class="assembly-post assembly-bank">
    {text.bank}
    <small>{text.charges}</small>
  </div>
  <div class="assembly-floor"></div>
</assembly-line-preview>

<script>
  import './assembly-line-preview';
</script>
