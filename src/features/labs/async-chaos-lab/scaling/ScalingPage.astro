---
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Locale } from '@/i18n/locale';
import LabHeader from '../shared/LabHeader.astro';
import { labPath } from '../shared/links';
import { labPagesCopy } from '../shared/lab-pages-copy';
import '../shared/stories.css';
import './scaling.css';
import './scaling-flow.css';
import './scaling-dialogs.css';
import './scaling-responsive.css';
import './scaling-admission.css';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const text = labPagesCopy(locale);
const title = text.scalingTitle;
---

<BaseLayout
  locale={locale}
  title={`${title} · Async Chaos Lab`}
  description={text.scalingDescription}
  alternatePaths={{ es: labPath('es', 3), en: labPath('en', 3) }}
>
  <LabHeader locale={locale} level={3} title={title} />
  <scaling-lab data-locale={locale}></scaling-lab>
  <noscript>{text.enableJavaScriptLab}</noscript>
</BaseLayout>
<script>
  import './controller';
</script>
