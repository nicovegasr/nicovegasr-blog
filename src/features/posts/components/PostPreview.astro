---
import { buildPostLink, type Post } from '@/features/posts/post';
import type { SeriesPosition } from '@/features/posts/post-series';
import { getTranslator } from '@/i18n/translator';
import ReadingTime from '@/shared/reading-time/ReadingTime.astro';
import TagList from '@/features/posts/components/TagList.astro';
import LeanMindPostPreview from '@/features/posts/components/LeanMindPostPreview.astro';

interface Props {
  post: Post;
  series?: SeriesPosition | undefined;
}

const VISIBLE_TAGS = 3;

const { post, series } = Astro.props;
const translate = getTranslator(post.locale);
const postLink = buildPostLink(post);
const linkTarget = post.external ? '_blank' : undefined;
const linkRelationship = post.external ? 'noopener' : undefined;
const readMoreLabel = post.external
  ? `${translate('blog.readOn')} ${post.external.publisher} ↗`
  : translate('blog.readMore');
// Short months come with a trailing dot in Spanish ("sept."); the uppercase mono meta reads cleaner without it.
const publicationDateLabel = new Intl.DateTimeFormat(post.locale, { day: 'numeric', month: 'short', year: 'numeric' })
  .formatToParts(post.publicationDate)
  .map((part) => (part.type === 'month' ? part.value.replace(/\.$/, '') : part.value))
  .join('');
const publicationDateMachine = post.publicationDate.toISOString().slice(0, 10);
const hiddenTagCount = Math.max(0, post.tags.length - VISIBLE_TAGS);
// Articles published on Lean Mind keep that blog's own identity inside the grid.
const isLeanMind = post.external?.publisher === 'Lean Mind';
---

{isLeanMind ? <LeanMindPostPreview post={post} /> : (

<article class:list={['post-preview', { 'is-external': post.external }]} data-slug={post.slug}>
  <div class="meta">
    <time datetime={publicationDateMachine}>{publicationDateLabel}</time>
    <span aria-hidden="true">·</span>
    <ReadingTime minutes={post.readingTimeInMinutes} locale={post.locale} />
  </div>
  {series && <span class="series">{series.name} · {series.number}/{series.total}</span>}
  <h2>
    <a href={postLink} target={linkTarget} rel={linkRelationship}>
      {series ? <><span class="visually-hidden">{series.name} — </span>{series.chapterTitle}</> : post.title}
      {post.external && <span class="visually-hidden"> — {readMoreLabel}</span>}
    </a>
  </h2>
  <p class="summary">{post.summary}</p>
  <div class="tags">
    <TagList tags={post.tags.slice(0, VISIBLE_TAGS)} />
    {hiddenTagCount > 0 && <span class="more-tags">+{hiddenTagCount}</span>}
  </div>
  <span class="read-more" aria-hidden="true">{readMoreLabel}</span>
</article>
)}

<style>
  .post-preview {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    height: 100%;
    padding: var(--space-6);
    border: 2px solid var(--color-ink);
    background: var(--color-paper);
    transition:
      transform var(--motion-duration-base) var(--motion-easing),
      box-shadow var(--motion-duration-base) var(--motion-easing);
  }

  /* Articles published elsewhere carry an ink band, like a different masthead. */
  .post-preview.is-external {
    background: linear-gradient(var(--color-ink), var(--color-ink)) 0 0 / 100% 6px no-repeat, var(--color-paper);
  }

  /* In the dark a full white frame on every card shouts; borders rest dim and light up on hover. */
  :global(:root[data-theme='dark']) .post-preview {
    border-color: color-mix(in srgb, var(--color-ink) 22%, transparent);
  }

  :global(:root[data-theme='dark']) .post-preview.is-external {
    background: linear-gradient(var(--color-accent), var(--color-accent)) 0 0 / 100% 4px no-repeat, var(--color-paper);
  }

  :global(:root[data-theme='dark']) .post-preview:is(:hover, :has(:focus-visible)) {
    border-color: var(--color-ink);
    box-shadow: 6px 6px 0 var(--color-accent);
  }

  .post-preview:has(:focus-visible) {
    transform: translate(-4px, -4px);
    box-shadow: 6px 6px 0 var(--color-ink);
  }

  @media (hover: hover) {
    .post-preview:hover {
      transform: translate(-4px, -4px);
      box-shadow: 6px 6px 0 var(--color-ink);
    }
  }

  .meta {
    display: flex;
    gap: var(--space-2);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-meta);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .series {
    align-self: flex-start;
    padding: 0.05em 0.5em;
    border: 1.5px solid var(--color-ink);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-meta);
    font-weight: 600;
  }

  .post-preview h2 {
    font-size: 1.35rem;
    line-height: 1.2;
    color: var(--color-ink);
  }

  .post-preview h2 a {
    text-decoration: none;
  }

  /* The whole card is the link's hit area. */
  .post-preview h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .summary {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    color: var(--color-text-soft);
    font-size: var(--font-size-small);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .more-tags {
    font-family: var(--font-family-mono);
    font-size: var(--font-size-meta);
    color: var(--color-text-muted);
  }

  .read-more {
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-rule);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-small);
    font-weight: 600;
    text-align: right;
    color: var(--color-ink);
  }
</style>
