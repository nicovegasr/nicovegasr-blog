---
import type { Post } from '@/features/posts/post';
import ReadingTime from '@/shared/reading-time/ReadingTime.astro';
import TagList from '@/features/posts/components/TagList.astro';
import { postsCopy } from '@/features/posts/copy';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const copy = postsCopy(post.locale);

const dateFormat = new Intl.DateTimeFormat(post.locale, { day: 'numeric', month: 'long', year: 'numeric' });
const machineDate = (date: Date): string => date.toISOString().slice(0, 10);
---

<div class="post-meta">
  <time datetime={machineDate(post.publicationDate)}>{dateFormat.format(post.publicationDate)}</time>
  {post.lastUpdateDate && (
    <>
      <span class="separator" aria-hidden="true">
        ·
      </span>
      <span>
        {copy.updated} <time datetime={machineDate(post.lastUpdateDate)}>{dateFormat.format(post.lastUpdateDate)}</time>
      </span>
    </>
  )}
  <span class="separator" aria-hidden="true">
    ·
  </span>
  <ReadingTime minutes={post.readingTimeInMinutes} locale={post.locale} />
  <TagList tags={post.tags} />
</div>

<style>
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-meta);
    color: var(--color-text-muted);
  }

  .post-meta time {
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .separator {
    color: var(--color-rule);
  }
</style>
