---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { CHALLENGES } from './challenges';
import { cardCopy } from './copy';
import { READ_CARDS, WRITE_CARDS } from './engine';
import './out-of-memory.css';

const title = 'Exit 137';
---

<BaseLayout locale="es" title={title} description="Monta un script que recorra meses de logs sin quedarse sin memoria.">
  <out-of-memory-lab class="oom">
    <h1 class="oom-visually-hidden">{title}</h1>
    <div class="oom-game" data-game>
      <header class="oom-hud">
        <nav class="oom-levels" aria-label="Retos">
          {CHALLENGES.map((challenge) => (
            <button type="button" data-challenge={challenge.id} aria-label={`Reto ${challenge.id}: ${challenge.title}`}>
              <b>{challenge.id}</b><small data-stars></small>
            </button>
          ))}
        </nav>
        <div class="oom-heading">
          <p class="oom-heading-title" data-title></p>
          <p class="oom-heading-mission" data-mission></p>
        </div>
        <ul class="oom-objectives" data-objectives aria-label="Estrellas del reto"></ul>
        <button type="button" class="oom-help" data-help>Tutorial</button>
      </header>

      <div class="oom-board">
        <section class="oom-code" data-code-panel aria-label="Tu código">
          <p class="oom-file">LogAnalyzerJob.java</p>
          <div class="oom-lines" data-code></div>
        </section>

        <section class="oom-stage" data-stage aria-label="El script">
          <div class="oom-memory" data-memory>
            <span>Mochila</span>
            <div class="oom-memory-bar"><i data-memory-fill></i><b data-memory-squeeze></b><u data-memory-goal hidden></u></div>
            <span data-memory-label></span>
          </div>
          <div class="oom-incident" data-incident hidden role="status"><b data-incident-title></b><span data-incident-text></span></div>
          <div class="oom-shelf" aria-hidden="true">
            <b>app_logs</b><small data-shelf-caption></small>
            <div class="oom-rows"><span data-rows></span></div>
          </div>
          <div class="oom-belt" aria-hidden="true"></div>
          <div class="oom-hero" data-hero aria-hidden="true">
            <i class="oom-pack" data-pack></i>
            <i class="oom-sprite" data-sprite></i>
            <i class="oom-carried" data-carried></i>
          </div>
          <div class="oom-cabinet" aria-hidden="true"><b>run_summaries</b><div class="oom-drawer" data-drawer></div></div>
          <div class="oom-stamp" aria-hidden="true"><strong>OOM Killed</strong><code>exit code 137</code></div>
          <div class="oom-floor"></div>
        </section>
      </div>

      <footer class="oom-tray">
        <div class="oom-progress" data-progress hidden><i></i></div>
        <div class="oom-hand" data-hand>
          {[
            { group: 'read', number: '①', title: 'Cómo coges los logs', cards: READ_CARDS },
            { group: 'write', number: '②', title: 'Cómo guardas', cards: WRITE_CARDS },
          ].map(({ group, number, title, cards }) => (
            <div class="oom-group" data-group={group}>
              <p class="oom-group-title"><b>{number}</b> {title}</p>
              <div class="oom-group-cards">
                {cards.map((card) => (
                  <div class="oom-card" data-card={card} draggable="true" hidden>
                    <button type="button" class="oom-card-face" data-place>
                      <span class="oom-card-front"><span class="oom-card-new">Nueva</span><span class="oom-card-placed">En el código ✓</span><b>{cardCopy[card].label}</b><small>{cardCopy[card].description}</small></span>
                      <span class="oom-card-back"><span class="oom-card-back-label">Código</span><code>{cardCopy[card].code}</code></span>
                    </button>
                    <button type="button" class="oom-card-flip" data-flip aria-label={`Ver el código de «${cardCopy[card].label}»`}>&lt;/&gt;</button>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
        <div class="oom-controls">
          <button type="button" class="oom-run" data-run>Ejecutar ▶</button>
          <button type="button" class="oom-secondary" data-pause hidden>❚❚ Pausar</button>
          <button type="button" class="oom-secondary" data-stop hidden>■ Parar</button>
        </div>
      </footer>

      <section class="oom-result oom-briefing" data-briefing role="dialog" aria-labelledby="oom-briefing-title" hidden>
        <div class="oom-result-card">
          <span class="oom-result-kicker" data-briefing-kicker></span>
          <p class="oom-result-title" id="oom-briefing-title" data-briefing-title></p>
          <p class="oom-result-text" data-briefing-mission></p>
          <ul class="oom-briefing-facts" data-briefing-facts></ul>
          <div>
            <p class="oom-briefing-heading">Para las tres estrellas</p>
            <ul class="oom-briefing-objectives" data-briefing-objectives></ul>
            <p class="oom-briefing-note">Los tienes siempre arriba, junto al reto.</p>
          </div>
          <div class="oom-result-actions">
            <button type="button" class="oom-run" data-briefing-start>Empezar</button>
          </div>
        </div>
      </section>

      <section class="oom-result" data-result role="dialog" aria-label="Resultado del reto" hidden>
        <div class="oom-result-card">
          <span class="oom-result-kicker" data-result-kicker></span>
          <p class="oom-result-stars" data-result-stars></p>
          <p class="oom-result-title" data-result-title></p>
          <ul class="oom-result-objectives" data-result-objectives></ul>
          <p class="oom-result-text" data-result-text></p>
          <table class="oom-compare">
            <caption class="oom-visually-hidden">Tus intentos en este reto</caption>
            <thead><tr><th scope="col">Tu elección</th><th scope="col">Estrellas</th><th scope="col">Memoria</th><th scope="col">Tiempo</th><th scope="col">Consultas</th><th scope="col">Viajes</th></tr></thead>
            <tbody data-compare></tbody>
          </table>
          <div class="oom-result-actions">
            <button type="button" class="oom-run" data-retry>↻ Reintentar</button>
            <button type="button" class="oom-secondary" data-next hidden>Siguiente reto →</button>
          </div>
        </div>
      </section>

      <div class="oom-coach" data-coach hidden>
        <div class="oom-dim" data-dim></div>
        <div class="oom-spotlight" data-spotlight></div>
        <div class="oom-spotlight" data-spotlight-also hidden></div>
        <div class="oom-bubble" data-bubble role="dialog" aria-live="polite">
          <span class="oom-bubble-step" data-bubble-step></span>
          <p class="oom-bubble-title" data-bubble-title></p>
          <p class="oom-bubble-text" data-bubble-text></p>
          <p class="oom-bubble-wait" data-bubble-wait></p>
          <div class="oom-bubble-actions">
            <button type="button" class="oom-bubble-skip" data-bubble-skip>Saltar tutorial</button>
            <button type="button" class="oom-bubble-next" data-bubble-next>Siguiente</button>
          </div>
        </div>
      </div>
    </div>
    <noscript>Activa JavaScript para jugar al laboratorio.</noscript>
  </out-of-memory-lab>
</BaseLayout>
<script>import './controller';</script>
