---
import { pillsCopy } from './copy';
import type { Locale } from '@/i18n/locale';
import ComingSoon from '@/layouts/ComingSoon.astro';
import ContentLayout from '@/layouts/ContentLayout.astro';
import PillShelf from '@/features/pills/components/PillShelf.astro';
import { findPillSeriesCards } from '@/features/pills/pill-repository';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = pillsCopy(locale);
const series = await findPillSeriesCards(locale);
---

<ContentLayout locale={locale} title={copy.heading} description={copy.metaDescription} lead={copy.lead} compact>
  {series.length > 0 ? (
    <PillShelf locale={locale} series={series} />
  ) : (
    <ComingSoon heading={copy.heading} message={copy.comingSoonText} />
  )}
</ContentLayout>
