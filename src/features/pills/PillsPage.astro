---
import type { Locale } from '@/i18n/locale';
import { getTranslator } from '@/i18n/translator';
import ComingSoon from '@/layouts/ComingSoon.astro';
import ContentLayout from '@/layouts/ContentLayout.astro';
import PillShelf from '@/features/pills/components/PillShelf.astro';
import { findPillSeriesCards } from '@/features/pills/pill-repository';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const translate = getTranslator(locale);
const series = await findPillSeriesCards(locale);
---

<ContentLayout
  locale={locale}
  title={translate('pills.heading')}
  description={translate('pills.metaDescription')}
  lead={translate('content.pillsLead')}
>
  {
    series.length > 0 ? (
      <PillShelf locale={locale} series={series} />
    ) : (
      <ComingSoon heading={translate('pills.heading')} message={translate('pills.comingSoonText')} />
    )
  }
</ContentLayout>
