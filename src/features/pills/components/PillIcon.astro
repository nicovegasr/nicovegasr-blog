---
import { PILL_ICONS } from '@/features/pills/pill-icons';

interface Props {
  icon: string;
}

const { icon } = Astro.props;
const drawing = PILL_ICONS[icon] ?? PILL_ICONS.summary!;
---

<svg class="pill-icon" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
  {drawing.body.map((d) => <path d={d} fill-rule="evenodd" />)}
  {drawing.signal && <path class="signal" d={drawing.signal} />}
</svg>

<style>
  .pill-icon {
    width: 26px;
    height: 26px;
    display: block;
    fill: currentColor;
  }
  .signal {
    fill: var(--pill-icon-signal, var(--color-accent));
  }
</style>
