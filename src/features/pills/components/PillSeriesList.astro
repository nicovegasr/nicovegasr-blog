---
import type { Locale } from '@/i18n/locale';
import { getTranslator } from '@/i18n/translator';
import type { PillSeriesCard } from '@/features/pills/pill';
import PillIcon from '@/features/pills/components/PillIcon.astro';
import { buildPillSeriesPath } from '@/i18n/routes';
import studentAtlas from '@/shared/mascot/age-2019.webp?url';

interface Props {
  locale: Locale;
  series: readonly PillSeriesCard[];
}

const { locale, series } = Astro.props;
const translate = getTranslator(locale);
---

<ul class="pill-series-list" style={`--student-atlas: url(${studentAtlas});`}>
  {
    series.map((item) => {
      const Card = item.draft ? 'div' : 'a';
      return (
        <li>
          <Card
            class:list={['series-card', { 'is-upcoming': item.draft }]}
            href={item.draft ? undefined : buildPillSeriesPath(locale, item.slug)}
          >
            <span class="series-icon"><PillIcon icon={item.icon} /></span>
            <span class="series-text">
              <span class="series-title">
                <b>{item.title}</b>
                {item.draft && <span class="upcoming-label">{translate('pills.upcoming')}</span>}
              </span>
              {!item.draft && <span class="series-description">{item.summary}</span>}
              {!item.draft && <span class="series-count">{item.pillCount} {translate('pills.seriesCount')}</span>}
            </span>
          </Card>
          <span class="series-mascot" aria-hidden="true"></span>
        </li>
      );
    })
  }
</ul>

<style>
  .pill-series-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }

  .pill-series-list li {
    position: relative;
  }

  .series-card {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-6);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-large);
    text-decoration: none;
    color: inherit;
    transition:
      border-color var(--motion-duration-fast) var(--motion-easing),
      background var(--motion-duration-fast) var(--motion-easing),
      color var(--motion-duration-fast) var(--motion-easing);
  }

  .series-icon {
    flex: 0 0 auto;
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-medium);
  }

  .is-upcoming {
    --construction-yellow: #facc15;
    border: 2px dashed var(--construction-yellow);
  }

  .series-text {
    min-width: 0;
  }

  .series-title {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
  }

  .upcoming-label {
    display: inline-block;
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--construction-yellow);
    border-radius: var(--radius-small);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-meta);
    line-height: 1.5;
    background: var(--construction-yellow);
    color: #0a0a0a;
  }

  .series-text b {
    display: block;
    font-family: var(--font-family-display);
    font-size: var(--font-size-heading-3);
    line-height: var(--line-height-heading);
  }

  .series-description {
    display: block;
    margin-top: var(--space-2);
    color: var(--color-text-soft);
    font-size: var(--font-size-small);
    line-height: 1.5;
  }

  .series-count {
    display: block;
    margin-top: var(--space-1);
    color: var(--color-text-soft);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-meta);
  }

  .series-mascot {
    position: absolute;
    right: 24px;
    bottom: 0;
    width: 88px;
    height: 88px;
    background: var(--student-atlas) 0 0 / 300% 200% no-repeat;
    opacity: 0;
    pointer-events: none;
  }

  @keyframes series-mascot-walk-in {
    0% { background-position: 0 0; transform: translateX(-24px); }
    25% { background-position: 50% 0; transform: translateX(-16px); }
    50% { background-position: 100% 0; transform: translateX(-8px); }
    75% { background-position: 50% 0; transform: translateX(-4px); }
    100% { background-position: 0 0; transform: none; }
  }

  .is-upcoming {
    padding-right: 120px;
  }

  .is-upcoming + .series-mascot {
    background-position: 50% 100%;
    opacity: 1;
  }

  @media (max-width: 480px) {
    .series-card { padding: var(--space-4); align-items: flex-start; }
    .series-icon { width: 40px; height: 40px; }
    .is-upcoming { padding-right: 84px; }
    .is-upcoming + .series-mascot { right: 6px; width: 76px; height: 76px; }
  }

  /* The space stays reserved so that the mascot never covers text or moves it on hover. */
  @media (hover: hover) and (pointer: fine) and (min-width: 481px) {
    a.series-card {
      padding-right: 120px;
    }

    a:is(:hover, :focus-visible) + .series-mascot {
      opacity: 1;
      animation: series-mascot-walk-in 480ms step-end;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    a:is(:hover, :focus-visible) + .series-mascot {
      animation: none;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .pill-series-list a:hover .series-count {
      color: var(--color-invert-muted);
    }
  }

  @media (hover: hover) {
    .pill-series-list a:hover {
      background: var(--color-invert-surface);
      color: var(--color-invert-text);
      border-color: var(--color-invert-surface);
    }

    .pill-series-list a:hover .series-description {
      color: var(--color-invert-muted);
    }

    .pill-series-list a:hover .series-icon {
      border-color: var(--color-invert-muted);
    }
  }
</style>
