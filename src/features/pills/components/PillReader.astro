---
import { collapsedIndexStorageKey } from '@/features/pills/reader-index-storage';
import type { Locale } from '@/i18n/locale';
import { getTranslator } from '@/i18n/translator';
import type { Pill, PillSeries } from '@/features/pills/pill';
import { pillLeafSlugOf } from '@/features/pills/pill';
import { findNextPillSeries, findRenderablePill } from '@/features/pills/pill-repository';
import { buildPagePath, buildPillPath } from '@/i18n/routes';
import PillReaderIndex from './PillReaderIndex.astro';
import ReadingTime from '@/shared/reading-time/ReadingTime.astro';
import PillMoment from '@/features/pills/moments/PillMoment.astro';

interface Props {
  locale: Locale;
  series: PillSeries;
  pills: readonly Pill[];
  activePillSlug?: string | undefined;
}

const { locale, series, pills, activePillSlug } = Astro.props;
const translate = getTranslator(locale);
const chapters = pills.map((pill, index) => {
  const slug = pillLeafSlugOf(pill.slug);
  return {
    ...pill,
    leaf: slug,
    isActive: activePillSlug ? slug === activePillSlug : pill === pills[0],
    number: String(index + 1).padStart(2, '0'),
    href: `${buildPillPath(locale, series.slug, slug)}#pill-reading`,
  };
});
const selectedIndex = chapters.findIndex((chapter) => chapter.isActive);
const selected = chapters[selectedIndex];
const previous = chapters[selectedIndex - 1];
const next = chapters[selectedIndex + 1];
const nextSeries = next ? null : await findNextPillSeries(locale, series.slug);
const forward =
  next ??
  (nextSeries
    ? {
        href: `${buildPillPath(locale, nextSeries.series.slug, pillLeafSlugOf(nextSeries.pill.slug))}#pill-reading`,
        title: nextSeries.pill.title,
      }
    : null);
const rendered = selected ? await findRenderablePill(locale, series.slug, selected.leaf) : null;
const Content = rendered?.Content;
---

<div class="notebook" id="pill-contents" tabindex="-1" data-pill-reader={`${locale}/${series.slug}`}>
  <script is:inline define:vars={{ collapsedIndexStorageKey }}>
    // Set before paint: without JavaScript the phone index stays open and usable.
    document.currentScript.parentElement.setAttribute('data-index-disclosure', 'closed');
    try {
      if (localStorage.getItem(collapsedIndexStorageKey) === 'true')
        document.currentScript.parentElement.setAttribute('data-index-collapsed', '');
    } catch {}
  </script>
  <PillReaderIndex locale={locale} series={series} chapters={chapters} />

  <div class="reading-desk">
    {selected && rendered && Content && (
      <section
        class="chapter-page"
        data-pill-swipe
        id="pill-reading"
        aria-labelledby="chapter-title"
        aria-keyshortcuts="ArrowLeft ArrowRight"
      >
        <div class="page-meta">
          <span>
            {translate('pills.reader.chapter')} {selected.number}
          </span>
          <span class="reading-time-slot">
            <ReadingTime minutes={rendered.readingTimeInMinutes} locale={locale} />
          </span>
          <span class="swipe-hint" data-swipe-hint>
            {translate('pills.reader.swipeTip')}
          </span>
        </div>
        <header class="chapter-heading">
          <h1 id="chapter-title" tabindex="-1">
            {selected.title}
          </h1>
          <p class="chapter-subtitle">{selected.subtitle}</p>
        </header>
        <div class="chapter-body prose">
          <Content />
        </div>
        {selected.momentStage && <PillMoment locale={locale} stage={selected.momentStage} />}
        <footer class="page-footer">
          <span class="folio">
            {selected.number} <span>/ {String(pills.length).padStart(2, '0')}</span>
          </span>
          <nav class="chapter-pagination" aria-label={translate('pills.reader.paginationLabel')}>
            {previous && (
              <a class="previous-chapter" href={previous.href}>
                <span class="pagination-arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <path d="M19 12H5m6-6-6 6 6 6" />
                  </svg>
                </span>
                <span class="pagination-copy">
                  {translate('pills.reader.previous')}
                  <strong>{previous.title}</strong>
                </span>
              </a>
            )}
            {forward ? (
              <a href={forward.href} class="next-chapter" data-pill-next-series={nextSeries ? true : undefined}>
                <span class="pagination-copy">
                  {nextSeries
                    ? `${translate('pills.reader.nextSeries')}: ${nextSeries.series.title}`
                    : translate('pills.reader.next')}
                  <strong>{forward.title}</strong>
                </span>
                <span class="pagination-arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <path d="M5 12h14m-6-6 6 6-6 6" />
                  </svg>
                </span>
              </a>
            ) : (
              <a href={buildPagePath('pills', locale)} class="back-link">
                {translate('pills.reader.allSeries')} →
              </a>
            )}
          </nav>
        </footer>
      </section>
    )}
  </div>
</div>

<script>
  import '../reader-navigation';
  import '../reader-keyboard-navigation';
  import '../reader-swipe-navigation';
  import '../reader-index-toggle';
</script>

<style>
  .notebook {
    scroll-margin-top: var(--space-24);
    display: grid;
    grid-template-columns: minmax(15rem, 0.8fr) minmax(0, 1.7fr);
    align-items: start;
  }
  .page-meta,
  .folio,
  .back-link {
    font-family: var(--font-family-mono);
    font-size: var(--font-size-meta);
  }
  @media (min-width: 801px) {
    .notebook[data-index-collapsed] {
      grid-template-columns: auto minmax(0, 1fr);
    }
  }
  .reading-desk {
    min-width: 0;
    border-left: 1px solid var(--color-rule);
  }
  .chapter-page {
    padding: var(--space-8) 0 var(--space-6) var(--space-8);
    scroll-margin-top: var(--space-24);
  }
  .page-meta {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    color: var(--color-text-soft);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .swipe-hint {
    display: none;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-small);
    background: var(--color-accent);
    color: var(--color-accent-ink);
    font-size: var(--font-size-small);
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
    white-space: nowrap;
  }
  @keyframes swipe-hint-nudge {
    0%,
    100% {
      transform: translateX(0);
    }
    25% {
      transform: translateX(-6px);
    }
    75% {
      transform: translateX(6px);
    }
  }
  @media not all and (hover: hover) and (pointer: fine) {
    /* The row keeps the hint's height so the title does not jump when it leaves. */
    .page-meta {
      align-items: center;
      min-height: 2.25rem;
    }
    .notebook[data-navigation-hint-visible] .swipe-hint {
      display: inline-block;
      animation: swipe-hint-nudge 900ms ease-in-out 2;
    }
    /* Narrow phones have no room for both, and a second row would move the title. */
    .notebook[data-navigation-hint-visible] .page-meta > span:first-child {
      display: none;
    }
    .notebook[data-navigation-hint-visible] .reading-time-slot {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .notebook[data-navigation-hint-visible] .swipe-hint {
      animation: none;
    }
  }
  .chapter-heading {
    position: relative;
    padding: var(--space-4) 0 var(--space-8);
    border-bottom: 1px solid var(--color-rule);
    margin-bottom: var(--space-8);
  }
  .chapter-heading h1:focus {
    outline: none;
  }
  .chapter-heading h1 {
    font-size: clamp(2.4rem, 5vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: -0.055em;
    margin-top: 0;
    max-width: 18ch;
    overflow-wrap: anywhere;
  }
  .chapter-subtitle {
    color: var(--color-text-soft);
    font-size: var(--font-size-lead);
    line-height: 1.5;
    margin-top: var(--space-4);
    max-width: 38ch;
  }
  .chapter-body {
    font-size: 1rem;
    line-height: 1.85;
    overflow-wrap: break-word;
  }
  .chapter-body :global(h2) {
    font-size: clamp(1.35rem, 2vw, 1.75rem);
  }
  .chapter-body :global(h3) {
    font-size: 1.25rem;
  }
  .chapter-body :global(img) {
    border-radius: var(--radius-small);
    cursor: zoom-in;
  }
  .chapter-body :global(pre) {
    max-width: 100%;
    font-size: var(--font-size-small);
  }
  .chapter-body :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: var(--font-size-small);
  }
  .chapter-body :global(th),
  .chapter-body :global(td) {
    border-bottom: 1px solid var(--color-rule);
    padding: var(--space-3);
    text-align: left;
  }
  .page-footer {
    display: grid;
    gap: var(--space-4);
    border-top: 1px solid var(--color-ink);
    margin-top: var(--space-12);
    padding-top: var(--space-6);
  }
  .folio {
    flex-shrink: 0;
  }
  .folio span {
    color: var(--color-text-soft);
  }
  .chapter-pagination {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
    min-width: 0;
  }
  .previous-chapter,
  .next-chapter {
    display: grid;
    align-items: center;
    gap: var(--space-3);
    min-width: 0;
    text-decoration: none;
    font-size: var(--font-size-meta);
    line-height: 1.5;
  }
  .previous-chapter {
    grid-template-columns: 40px minmax(0, 1fr);
  }
  .next-chapter {
    grid-column: 2;
    grid-template-columns: minmax(0, 1fr) 40px;
    text-align: right;
  }
  .pagination-copy {
    align-self: start;
    display: grid;
    gap: var(--space-1);
  }
  .pagination-copy strong {
    font-family: var(--font-family-display);
    font-size: 1rem;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .pagination-arrow {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-ink);
    border-radius: 50%;
  }
  .next-chapter .pagination-arrow {
    background: var(--color-accent);
    color: var(--color-accent-ink);
    border-color: var(--color-accent-ink);
  }
  .pagination-arrow svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .back-link {
    grid-column: 2;
    justify-self: end;
    align-self: center;
    text-align: right;
  }
  @media (max-width: 800px) {
    .notebook {
      grid-template-columns: 1fr;
    }
    .reading-desk {
      border-left: 0;
      border-top: 1px solid var(--color-ink);
      background: none;
    }
    .chapter-page {
      padding: var(--space-6) 0;
    }
    .chapter-heading h1 {
      font-size: clamp(2.25rem, 8vw, 3.5rem);
    }
  }
  @media (max-width: 480px) {
    .page-meta {
      flex-wrap: wrap;
    }
    .page-footer {
      align-items: flex-start;
    }
    .chapter-pagination {
      gap: var(--space-3);
    }
    .previous-chapter,
    .next-chapter {
      gap: var(--space-2);
    }
    .pagination-copy strong {
      font-size: var(--font-size-small);
    }
    .chapter-heading {
      padding-top: var(--space-8);
    }
  }
</style>
