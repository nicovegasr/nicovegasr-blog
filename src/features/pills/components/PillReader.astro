---
import type { Locale } from '@/i18n/locale';
import { getTranslator } from '@/i18n/translator';
import type { Pill, PillSeries } from '@/features/pills/pill';
import { pillLeafSlugOf } from '@/features/pills/pill';
import { findNextPillSeries, findRenderablePill } from '@/features/pills/pill-repository';
import { buildPagePath, buildPillPath } from '@/i18n/routes';
import PillIcon from './PillIcon.astro';
import ReadingTime from '@/shared/reading-time/ReadingTime.astro';
import SystemMap from '@/features/pills/system-map/SystemMap.astro';

interface Props {
  locale: Locale;
  series: PillSeries;
  pills: readonly Pill[];
  activePillSlug?: string | undefined;
}

const { locale, series, pills, activePillSlug } = Astro.props;
const translate = getTranslator(locale);
const chapters = pills.map((pill, index) => {
  const slug = pillLeafSlugOf(pill.slug);
  return {
    ...pill,
    leaf: slug,
    isActive: activePillSlug ? slug === activePillSlug : pill === pills[0],
    number: String(index + 1).padStart(2, '0'),
    href: `${buildPillPath(locale, series.slug, slug)}#pill-reading`,
  };
});
const selectedIndex = chapters.findIndex((chapter) => chapter.isActive);
const selected = chapters[selectedIndex];
const previous = chapters[selectedIndex - 1];
const next = chapters[selectedIndex + 1];
const nextSeries = next ? null : await findNextPillSeries(locale, series.slug);
const forward = next ?? (nextSeries ? {
  href: `${buildPillPath(locale, nextSeries.series.slug, pillLeafSlugOf(nextSeries.pill.slug))}#pill-reading`,
  title: nextSeries.pill.title,
} : null);
const rendered = selected
  ? await findRenderablePill(locale, series.slug, selected.leaf)
  : null;
const Content = rendered?.Content;

---

<div class="notebook" id="pill-contents" tabindex="-1" data-pill-reader={`${locale}/${series.slug}`}>
  <script is:inline>
    try {
      if (localStorage.getItem('pills.index.collapsed') === 'true')
        document.currentScript.parentElement.setAttribute('data-index-collapsed', '');
    } catch {}
  </script>
  <aside
    id="pill-index"
    class="contents"
    transition:persist={`pill-index-${locale}-${series.slug}`}
    transition:animate="none"
  >
    <div class="contents-heading">
      <span class="eyebrow">{translate('pills.reader.heading')}</span>
      <span class="count">
        {String(pills.length).padStart(2, '0')} {translate('pills.seriesCount')}
      </span>
      <button
        type="button"
        class="index-toggle"
        data-pill-index-toggle
        aria-controls="pill-index"
        aria-expanded="true"
        aria-label={translate('pills.reader.toggleIndex')}
        title={translate('pills.reader.toggleIndex')}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="4.5" width="17" height="15" rx="2" /><path d="M9.5 4.5v15" /></svg>
      </button>
    </div>
    <nav aria-label={translate('pills.reader.heading')}>
      <ol class="journey">
        {chapters.map((chapter) => (
          <li>
            <a href={chapter.href} data-pill-link title={chapter.title} aria-current={chapter.isActive ? 'page' : undefined}>
              <span class="station"><PillIcon icon={chapter.icon} /></span>
              <span class="stop-copy">
                <span class="stop-number">
                  {translate('pills.reader.chapter')} {chapter.number}
                </span>
                <strong>{chapter.title}</strong>
                <span class="stop-description">{chapter.subtitle}</span>
              </span>
              <span class="stop-arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </aside>

  <div class="reading-desk">
    {selected && rendered && Content && (
      <section class="chapter-page" data-pill-swipe id="pill-reading" aria-labelledby="chapter-title" aria-keyshortcuts="ArrowLeft ArrowRight">
        <div class="page-meta">
          <span>{translate('pills.reader.chapter')} {selected.number}</span>
          <ReadingTime minutes={rendered.readingTimeInMinutes} locale={locale} />
        </div>
        <header class="chapter-heading">
          <h2 id="chapter-title" tabindex="-1">{selected.title}</h2>
          <p class="chapter-subtitle">{selected.subtitle}</p>
        </header>
        <div class="chapter-body prose"><Content /></div>
        {selected.systemMapStage && <SystemMap locale={locale} stage={selected.systemMapStage} />}
        <footer class="page-footer">
          <span class="folio">{selected.number} <span>/ {String(pills.length).padStart(2, '0')}</span></span>
          <nav class="chapter-pagination" aria-label={translate('pills.reader.paginationLabel')}>
            {previous && (
              <a class="previous-chapter" href={previous.href}>
                <span class="pagination-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M19 12H5m6-6-6 6 6 6" /></svg></span>
                <span class="pagination-copy">{translate('pills.reader.previous')}<strong>{previous.title}</strong></span>
              </a>
            )}
            {forward ? (
              <a href={forward.href} class="next-chapter" data-pill-next-series={nextSeries ? true : undefined}>
                <span class="pagination-copy">{nextSeries ? `${translate('pills.reader.nextSeries')}: ${nextSeries.series.title}` : translate('pills.reader.next')}<strong>{forward.title}</strong></span>
                <span class="pagination-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></span>
              </a>
            ) : (
              <a href={buildPagePath('pills', locale)} class="back-link">{translate('pills.reader.allSeries')} →</a>
            )}
          </nav>
        </footer>
      </section>
    )}
  </div>
</div>

<script>
  import '../reader-navigation';
  import '../reader-keyboard-navigation';
  import '../reader-swipe-navigation';
  import '../reader-index-toggle';
</script>

<style>
  .notebook {
    scroll-margin-top: var(--space-24);
    display: grid;
    grid-template-columns: minmax(15rem, 0.8fr) minmax(0, 1.7fr);
    border-top: 1px solid var(--color-ink);
    align-items: start;
  }
  .contents {
    position: sticky;
    top: var(--space-24);
    max-height: calc(100dvh - 8rem);
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--color-text-muted) transparent;
    padding: var(--space-8) var(--space-6) var(--space-6) 0;
  }
  .eyebrow,
  .count,
  .stop-number,
  .page-meta,
  .folio,
  .back-link {
    font-family: var(--font-family-mono);
    font-size: var(--font-size-meta);
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .contents-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
  }
  .count {
    color: var(--color-text-soft);
    white-space: nowrap;
    margin-left: auto;
  }
  .index-toggle {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-small);
    background: var(--color-paper);
    color: var(--color-text-soft);
    cursor: pointer;
    transition:
      color var(--motion-duration-fast),
      border-color var(--motion-duration-fast);
  }
  .index-toggle:hover {
    color: var(--color-ink);
    border-color: var(--color-ink);
  }
  .index-toggle svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linejoin: round;
  }
  @media (min-width: 801px) {
    .notebook[data-index-collapsed] {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .notebook[data-index-collapsed] .contents {
      padding-right: var(--space-4);
    }
    .notebook[data-index-collapsed] .contents-heading {
      justify-content: center;
    }
    .notebook[data-index-collapsed] :is(.eyebrow, .count, .stop-arrow) {
      display: none;
    }
    .notebook[data-index-collapsed] .journey a {
      grid-template-columns: var(--station-size);
    }
    /* Keep chapter names as each link's accessible name while only icons show. */
    .notebook[data-index-collapsed] .stop-copy {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
  .journey {
    --station-size: 42px;
    list-style: none;
    padding: var(--space-1);
    margin: var(--space-6) 0;
  }
  .journey li {
    position: relative;
  }
  /* Each segment joins row centers, even when titles wrap to different heights. */
  .journey li::before {
    content: '';
    position: absolute;
    left: calc(var(--space-1) + var(--station-size) / 2 - 0.5px);
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--color-rule);
  }
  .journey li:first-child::before {
    top: 50%;
  }
  .journey li:last-child::before {
    bottom: 50%;
  }
  .journey a {
    display: grid;
    grid-template-columns: var(--station-size) minmax(0, 1fr) var(--space-6);
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-1);
    text-decoration: none;
    position: relative;
    border-radius: var(--radius-small);
  }
  .station {
    width: var(--station-size);
    height: var(--station-size);
    border: 1px solid var(--color-rule);
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--color-paper);
    z-index: 1;
    transition:
      background var(--motion-duration-fast),
      border-color var(--motion-duration-fast),
      transform var(--motion-duration-fast);
  }
  .station :global(svg) {
    width: 20px;
    height: 20px;
  }
  .stop-copy {
    display: grid;
    gap: var(--space-1);
    min-width: 0;
  }
  .stop-number {
    font-size: 0.625rem;
    color: var(--color-text-soft);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .stop-copy strong {
    font-family: var(--font-family-display);
    font-size: 1rem;
    line-height: 1.25;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .stop-description {
    font-size: 0.75rem;
    color: var(--color-text-soft);
    line-height: 1.5;
  }
  .stop-arrow {
    display: grid;
    place-items: center;
    width: var(--space-6);
    height: var(--space-6);
    color: var(--color-text-soft);
    transition: transform var(--motion-duration-fast) var(--motion-easing);
  }
  .stop-arrow svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .journey a[aria-current] {
    background: color-mix(in srgb, var(--color-accent) 7%, var(--color-paper));
    color: var(--color-ink);
    box-shadow: inset 3px 0 0 var(--color-accent);
  }
  .journey a[aria-current] .station {
    --pill-icon-signal: var(--color-accent-ink);
    background: var(--color-accent);
    color: var(--color-accent-ink);
    border-color: var(--color-accent-ink);
  }
  .journey a[aria-current] .stop-number,
  .journey a[aria-current] .stop-arrow {
    color: var(--color-ink);
  }
  .reading-desk {
    min-width: 0;
    border-left: 1px solid var(--color-rule);
  }
  .chapter-page {
    padding: var(--space-8) 0 var(--space-6) var(--space-8);
    scroll-margin-top: var(--space-24);
  }
  .page-meta {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    color: var(--color-text-soft);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .chapter-heading {
    position: relative;
    padding: var(--space-6) 0 var(--space-8);
    border-bottom: 1px solid var(--color-rule);
    margin-bottom: var(--space-8);
  }
  .chapter-heading h2:focus { outline: none; }
  .chapter-heading h2 {
    font-size: clamp(2rem, 3.5vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.055em;
    margin-top: 0;
    max-width: 18ch;
    overflow-wrap: anywhere;
  }
  .chapter-subtitle {
    color: var(--color-text-soft);
    font-size: var(--font-size-lead);
    line-height: 1.5;
    margin-top: var(--space-4);
    max-width: 38ch;
  }
  .chapter-body {
    font-size: 1rem;
    line-height: 1.85;
    overflow-wrap: break-word;
  }
  .chapter-body :global(h2) {
    font-size: clamp(1.35rem, 2vw, 1.75rem);
  }
  .chapter-body :global(h3) {
    font-size: 1.25rem;
  }
  .chapter-body :global(img) {
    border-radius: var(--radius-small);
  }
  .chapter-body :global(pre) {
    max-width: 100%;
    font-size: var(--font-size-small);
  }
  .chapter-body :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: var(--font-size-small);
  }
  .chapter-body :global(th),
  .chapter-body :global(td) {
    border-bottom: 1px solid var(--color-rule);
    padding: var(--space-3);
    text-align: left;
  }
  .page-footer {
    display: grid;
    gap: var(--space-4);
    border-top: 1px solid var(--color-ink);
    margin-top: var(--space-12);
    padding-top: var(--space-6);
  }
  .folio {
    flex-shrink: 0;
  }
  .folio span {
    color: var(--color-text-soft);
  }
  .chapter-pagination {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
    min-width: 0;
  }
  .previous-chapter,
  .next-chapter {
    display: grid;
    align-items: center;
    gap: var(--space-3);
    min-width: 0;
    text-decoration: none;
    font-size: var(--font-size-meta);
    line-height: 1.5;
  }
  .previous-chapter {
    grid-template-columns: 40px minmax(0, 1fr);
  }
  .next-chapter {
    grid-column: 2;
    grid-template-columns: minmax(0, 1fr) 40px;
    text-align: right;
  }
  .pagination-copy {
    align-self: start;
    display: grid;
    gap: var(--space-1);
  }
  .pagination-copy strong {
    font-family: var(--font-family-display);
    font-size: 1rem;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .pagination-arrow {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-ink);
    border-radius: 50%;
  }
  .next-chapter .pagination-arrow {
    background: var(--color-accent);
    color: var(--color-accent-ink);
    border-color: var(--color-accent-ink);
  }
  .pagination-arrow svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .back-link {
    grid-column: 2;
    justify-self: end;
    align-self: center;
    text-align: right;
  }
  @media (hover: hover) {
    .journey a:not([aria-current]):hover .station {
      transform: scale(1.08);
      border-color: var(--color-ink);
    }
    .journey a:hover .stop-arrow {
      transform: translateX(3px);
    }
  }
  @media (max-width: 800px) {
    .notebook {
      grid-template-columns: 1fr;
    }
    .index-toggle {
      display: none;
    }
    .contents {
      position: static;
      max-height: none;
      overflow: visible;
      padding: var(--space-6) 0;
    }
    .journey {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0 var(--space-4);
      margin-bottom: 0;
    }
    .journey li::before {
      display: none;
    }
    .reading-desk {
      border-left: 0;
      border-top: 1px solid var(--color-ink);
      background: none;
    }
    .chapter-page {
      padding: var(--space-6) 0;
    }
    .chapter-heading h2 {
      font-size: clamp(2.25rem, 8vw, 3.5rem);
    }
  }
  @media (max-width: 480px) {
    .journey {
      --station-size: 36px;
      grid-template-columns: 1fr;
    }
    .journey a {
      padding-block: var(--space-2);
    }
    .journey li::before {
      display: block;
    }
    .stop-number {
      display: none;
    }
    .stop-copy strong {
      font-size: var(--font-size-small);
    }
    .stop-description {
      font-size: 0.6875rem;
    }
    .page-meta {
      flex-wrap: wrap;
    }
    .page-footer {
      align-items: flex-start;
    }
    .chapter-pagination {
      gap: var(--space-3);
    }
    .previous-chapter,
    .next-chapter {
      gap: var(--space-2);
    }
    .pagination-copy strong {
      font-size: var(--font-size-small);
    }
    .chapter-heading {
      padding-top: var(--space-8);
    }
  }
</style>
