---
import type { Locale } from '@/i18n/locale';
import { getTranslator } from '@/i18n/translator';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const translate = getTranslator(locale);
---

<aside class="keyboard-tip" data-reader-keyboard-tip aria-label={translate('pills.reader.keyboardTipLabel')} hidden>
  <span class="keys" aria-hidden="true">
    <kbd>←</kbd>
    <kbd>→</kbd>
  </span>
  <p>{translate('pills.reader.keyboardTip')}</p>
  <span class="seconds" aria-hidden="true" data-keyboard-tip-seconds>
    3
  </span>
</aside>

<script>
  import '../reader-keyboard-tip';
</script>

<style>
  .keyboard-tip {
    position: fixed;
    inset-inline-end: var(--space-6);
    bottom: var(--space-6);
    z-index: 20;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    width: max-content;
    max-width: min(26rem, calc(100vw - var(--space-12)));
    padding: var(--space-3) var(--space-4);
    pointer-events: none;
    border: 1px solid var(--color-ink);
    border-radius: var(--radius-small);
    background: var(--color-paper);
    color: var(--color-ink);
    box-shadow: var(--space-1) var(--space-1) 0 var(--color-ink);
    font-size: var(--font-size-small);
    line-height: 1.5;
  }
  .keyboard-tip[hidden] {
    display: none;
  }
  .keys {
    display: flex;
    gap: var(--space-1);
    flex-shrink: 0;
  }
  /* Touch devices get their swipe hint beside the pill title instead. */
  @media not all and (hover: hover) and (pointer: fine) {
    .keyboard-tip {
      display: none;
    }
  }
  .seconds {
    flex-shrink: 0;
    color: var(--color-text-soft);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-small);
    font-variant-numeric: tabular-nums;
  }
  kbd {
    display: grid;
    place-items: center;
    width: var(--space-8);
    height: var(--space-8);
    border: 1px solid var(--color-accent-ink);
    border-radius: var(--radius-small);
    background: var(--color-accent);
    color: var(--color-accent-ink);
    font-family: var(--font-family-mono);
    font-size: var(--font-size-small);
  }
</style>
