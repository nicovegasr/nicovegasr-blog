---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PillReader from '@/features/pills/components/PillReader.astro';
import PillImageZoom from '@/features/pills/components/PillImageZoom.astro';
import ReaderKeyboardTip from '@/features/pills/components/ReaderKeyboardTip.astro';
import type { Locale } from '@/i18n/locale';
import { getTranslator } from '@/i18n/translator';
import { buildPillPath, buildPillSeriesPath } from '@/i18n/routes';
import { findRenderablePillSeries } from '@/features/pills/pill-repository';
import { pillLeafSlugOf } from '@/features/pills/pill';

interface Props {
  locale: Locale;
  seriesSlug: string;
  activePillSlug?: string;
}
const { locale, seriesSlug, activePillSlug } = Astro.props;
const renderable = await findRenderablePillSeries(locale, seriesSlug);
if (!renderable)
  throw new Error(`Pill series not found: ${locale}/${seriesSlug}`);
const { series, pills } = renderable;
const activePill = pills.find(
  (pill) => pillLeafSlugOf(pill.slug) === activePillSlug,
);
if (activePillSlug && !activePill)
  throw new Error(`Pill not found: ${activePillSlug}`);
const translate = getTranslator(locale);
const otherLocale = locale === 'es' ? 'en' : 'es';
const alternatePaths = {
  [otherLocale]: activePillSlug
    ? buildPillPath(otherLocale, series.slug, activePillSlug)
    : buildPillSeriesPath(otherLocale, series.slug),
};

---

<BaseLayout
  locale={locale}
  clientNavigation
  title={activePill ? `${activePill.title} — ${series.title}` : `${series.title} — ${translate('pills.heading')}`}
  description={activePill?.subtitle ?? series.summary}
  openGraphType={activePill ? 'article' : 'website'}
  alternatePaths={alternatePaths}
>
  <article class="series-notebook">
    <PillReader locale={locale} series={series} pills={pills} activePillSlug={activePillSlug} />
  </article>
  <ReaderKeyboardTip locale={locale} />
  <PillImageZoom locale={locale} />
</BaseLayout>

<style>
  @media (max-width: 800px) {
    .series-notebook {
      margin-top: calc(var(--space-6) - var(--space-16));
    }
  }
</style>
