---
import type { Locale } from '@/i18n/locale';
import { getTranslator } from '@/i18n/translator';
import { systemMapAt, type SystemMapStage } from './system-map';

interface Props {
  locale: Locale;
  stage: SystemMapStage;
}

const { locale, stage } = Astro.props;
const translate = getTranslator(locale);
const areas = systemMapAt(stage, locale);
---

<figure class="system-map">
  <figcaption>
    <span class="heading">{translate('pills.systemMap.heading')}</span>
    <span class="legend" aria-hidden="true">
      <span class="swatch"></span>{translate('pills.systemMap.new')}
    </span>
  </figcaption>
  <ol class="areas">
    {areas.map((area) => (
      <li class="area">
        <span class="area-name">{area.name}</span>
        <ul class="pieces">
          {area.pieces.map((piece) => (
            <li class="piece" data-new={piece.isNew ? '' : undefined}>
              {piece.code && <code>{piece.code}</code>}
              <span>{piece.label}</span>
              {piece.isNew && <span class="visually-hidden">({translate('pills.systemMap.new')})</span>}
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ol>
</figure>

<style>
  .system-map {
    --rail-dot: 9px;
    margin: var(--space-12) 0 0;
    padding: var(--space-6);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-medium);
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    margin-bottom: var(--space-6);
    font-family: var(--font-family-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .legend {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-soft);
  }
  .swatch {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    background: var(--color-accent);
    border: 1px solid var(--color-accent-ink);
  }
  .areas {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-4);
  }
  /* A rail joins the areas in reading order, from supplier input to pricing. */
  .area {
    position: relative;
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: var(--space-3);
    align-items: start;
    padding-left: var(--space-6);
  }
  .area::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.45rem;
    width: var(--rail-dot);
    height: var(--rail-dot);
    border-radius: 50%;
    background: var(--color-ink);
  }
  .area:not(:last-child)::after {
    content: '';
    position: absolute;
    left: calc(var(--rail-dot) / 2 - 0.5px);
    top: calc(0.45rem + var(--rail-dot));
    bottom: calc(-1 * var(--space-4) - 0.45rem);
    width: 1px;
    background: var(--color-rule);
  }
  .area-name {
    font-family: var(--font-family-display);
    font-weight: 600;
    font-size: var(--font-size-small);
    line-height: 1.6;
  }
  .pieces {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .piece {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-small);
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--color-text-soft);
  }
  .piece code {
    padding: 0;
    background: none;
    font-size: 0.75rem;
    color: var(--color-ink);
  }
  .piece[data-new] {
    background: var(--color-accent);
    border-color: var(--color-accent-ink);
    color: var(--color-accent-ink);
  }
  .piece[data-new] code {
    color: var(--color-accent-ink);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (max-width: 480px) {
    .system-map {
      padding: var(--space-4);
    }
    .area {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }
</style>
