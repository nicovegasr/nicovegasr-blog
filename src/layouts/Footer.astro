---
import type { Locale } from '@/i18n/locale';
import { getTranslator } from '@/i18n/translator';
import SocialLinks from '@/layouts/SocialLinks.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const translate = getTranslator(locale);
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="bar">
    <p class="copyright">
      © {currentYear} Nicolás Vegas
      <span> — {translate('footer.rights')}</span>
    </p>
    <div class="social">
      <SocialLinks />
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-rule);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    max-width: var(--content-width-wide);
    margin-inline: auto;
    padding: var(--space-4) var(--space-6);
    text-align: start;
  }

  .copyright {
    font-size: var(--font-size-small);
    line-height: 1.5;
    color: var(--color-text-soft);
    white-space: nowrap;
  }

  .social {
    flex: 0 0 auto;
  }

  .social :global(.social-links) {
    flex-wrap: nowrap;
    gap: var(--space-2);
  }

  .social :global(.social-links a) {
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
  }

  .social :global(.social-links svg) {
    width: 18px;
    height: 18px;
  }

  @media (max-width: 48rem) {
    .bar {
      gap: var(--space-2);
    }

    .copyright {
      font-size: var(--font-size-meta);
    }

    .copyright span {
      display: none;
    }

    .social :global(.social-links svg) {
      width: 16px;
      height: 16px;
    }
  }

  @media (max-width: 24rem) {
    .bar {
      padding-inline: var(--space-3);
    }

    .copyright {
      font-size: 0.6875rem;
    }

    .social :global(.social-links) {
      gap: var(--space-1);
    }

    .social :global(.social-links a) {
      width: 2.25rem;
      height: 2.25rem;
    }
  }
</style>
