---
import { ClientRouter } from 'astro:transitions';
import type { Locale } from '@/i18n/locale';
import { LOCALES, DEFAULT_LOCALE, OPEN_GRAPH_LOCALE } from '@/i18n/locale';
import { getTranslator } from '@/i18n/translator';
import { buildAlternateLocalePath, localesOtherThan, buildRssFeedPath } from '@/i18n/routes';
import Navigation from '@/layouts/Navigation.astro';
import Footer from '@/layouts/Footer.astro';

import '@fontsource-variable/space-grotesk/wght.css';
import '@fontsource-variable/inter/wght.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@/styles/tokens.css';
import '@/styles/base.css';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  openGraphType?: 'website' | 'article';
  clientNavigation?: boolean;
  alternatePaths?: Partial<Record<Locale, string>>;
}

const {
  locale,
  title,
  description,
  openGraphType = 'website',
  clientNavigation = false,
  alternatePaths = {},
} = Astro.props;
const translate = getTranslator(locale);

const documentTitle = title ?? translate('site.title');
const documentDescription = description ?? translate('site.description');
const siteName = translate('site.title');

const currentPathname = Astro.url.pathname;
const toAbsoluteUrl = (path: string): string => new URL(path, Astro.site).toString();
const canonicalUrl = toAbsoluteUrl(currentPathname);
const openGraphImageUrl = toAbsoluteUrl('/og-default.png');
const pathForLocale = (target: Locale): string =>
  target === locale
    ? currentPathname
    : (alternatePaths[target] ?? buildAlternateLocalePath(currentPathname, locale, target));
---

<!doctype html>
<html lang={locale} data-client-navigation={clientNavigation || undefined} transition:animate="none">
  <head>
    <meta charset="utf-8" />
    {clientNavigation && <ClientRouter fallback="swap" />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      // Antes del primer pintado: marca que hay JS (gatea las animaciones de
      // aparición; sin JS el contenido se ve) y fija el tema para evitar parpadeo.
      document.documentElement.classList.add('js');
      const storedTheme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const theme = storedTheme ?? (prefersDark ? 'dark' : 'light');
      document.documentElement.dataset.theme = theme;
    </script>
    <title>{documentTitle}</title>
    <meta name="description" content={documentDescription} />
    <link rel="canonical" href={canonicalUrl} />
    {
      LOCALES.map((target) => (
        <link rel="alternate" hreflang={target} href={toAbsoluteUrl(pathForLocale(target))} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={toAbsoluteUrl(pathForLocale(DEFAULT_LOCALE))} />

    <meta property="og:type" content={openGraphType} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={documentDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={OPEN_GRAPH_LOCALE[locale]} />
    {
      localesOtherThan(locale).map((target) => (
        <meta property="og:locale:alternate" content={OPEN_GRAPH_LOCALE[target]} />
      ))
    }
    <meta property="og:image" content={openGraphImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={siteName} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={documentDescription} />
    <meta name="twitter:image" content={openGraphImageUrl} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteName}
      href={toAbsoluteUrl(buildRssFeedPath(locale))}
    />
  </head>
  <body>
    <Navigation locale={locale} alternatePaths={alternatePaths} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />

    <script>
      let revealObserver: IntersectionObserver | undefined;
      const revealContent = () => {
        revealObserver?.disconnect();
        const items = document.querySelectorAll('.reveal:not(.is-visible)');
        if ('IntersectionObserver' in window && items.length > 0) {
          revealObserver = new IntersectionObserver((entries, observer) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          }, { rootMargin: '0px 0px -10% 0px' });
          items.forEach((item) => revealObserver!.observe(item));
        } else {
          items.forEach((item) => item.classList.add('is-visible'));
        }
      };
      document.addEventListener('astro:page-load', revealContent);
      document.addEventListener('astro:before-swap', (event) => {
        event.newDocument.documentElement.dataset.theme =
          document.documentElement.dataset.theme ?? 'light';
      });
      revealContent();
    </script>
  </body>
</html>
