---
import type { Locale } from '@/i18n/locale';
import { getTranslator } from '@/i18n/translator';

interface Props {
  locale: Locale;
  // Sin la pregunta queda solo el contador, para acompañar a otro enlace (p. ej. en el hero).
  showPrompt?: boolean;
  class?: string;
}

const { locale, showPrompt = true, class: className } = Astro.props;
const translate = getTranslator(locale);
---

<a
  class:list={['repo-star', className]}
  href="https://github.com/nicovegasr/nicovegasr-blog"
  target="_blank"
  rel="noopener noreferrer"
>
  {showPrompt && <span class="accent-underline">{translate('blog.starPrompt')}</span>}
  <img
    src="https://img.shields.io/github/stars/nicovegasr/nicovegasr-blog?style=social"
    alt={translate('blog.starCount')}
    width="80"
    height="20"
    decoding="async"
    referrerpolicy="no-referrer"
  />
</a>

<style>
  .repo-star {
    display: inline-flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    min-height: 44px;
    margin-top: var(--space-2);
    padding-block: var(--space-2);
    color: var(--color-text-soft);
    font-size: var(--font-size-small);
    line-height: 1.5;
    text-decoration: none;
  }

  .repo-star img {
    flex-shrink: 0;
    width: auto;
    height: 20px;
    max-width: none;
  }

  .repo-star img {
    transition: opacity var(--motion-duration-fast) var(--motion-easing);
  }

  .repo-star:focus-visible {
    color: var(--color-ink);
  }

  .repo-star:focus-visible span {
    text-decoration-thickness: 3px;
  }

  .repo-star:focus-visible img {
    opacity: 0.7;
  }

  @media (hover: hover) {
    .repo-star:hover {
      color: var(--color-ink);
    }

    .repo-star:hover span {
      text-decoration-thickness: 3px;
    }

    .repo-star:hover img {
      opacity: 0.7;
    }
  }
</style>
