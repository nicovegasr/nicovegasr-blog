---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostMeta from '@/features/posts/components/PostMeta.astro';
import PostTitle from '@/features/posts/components/PostTitle.astro';
import RelatedPosts from '@/features/posts/components/RelatedPosts.astro';
import CopyableCode from '@/features/posts/components/CopyableCode.astro';
import { buildBlogPostPath } from '@/i18n/routes';
import {
  findHostedPosts,
  findRelatedPosts,
  findRenderablePost,
} from '@/features/posts/post-repository';

const locale = 'es';

export async function getStaticPaths() {
  const posts = await findHostedPosts('es');
  return posts.map((post) => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;
const renderable = slug ? await findRenderablePost(locale, slug) : null;
if (renderable === null) {
  throw new Error(`Post not found: ${locale}/${slug}`);
}

const { post, markdown, Content } = renderable;
const relatedPosts = await findRelatedPosts(locale, post.slug);
const alternatePaths = post.translationSlug
  ? { en: buildBlogPostPath('en', post.translationSlug) }
  : {};
---

<BaseLayout
  locale={locale}
  title={post.title}
  description={post.summary}
  openGraphType="article"
  alternatePaths={alternatePaths}
>
  <article class="reveal">
    <header class="article-header">
      <PostTitle title={post.title} markdown={markdown} locale={locale} />
      <PostMeta post={post} />
    </header>
    <CopyableCode locale={locale}>
      <Content />
    </CopyableCode>
  </article>
  <RelatedPosts posts={relatedPosts} locale={locale} />
</BaseLayout>
