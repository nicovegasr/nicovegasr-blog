---
import PillNotebook from '@/features/pills/components/PillNotebook.astro';
import { findAllPillSeries } from '@/features/pills/pill-repository';

export async function getStaticPaths() {
  const series = await findAllPillSeries('en');
  return series.map((item) => ({ params: { series: item.slug } }));
}
const { series } = Astro.params;
if (!series) throw new Error('Missing pill series');

---

<PillNotebook locale="en" seriesSlug={series} />
