---
import PillNotebook from '@/features/pills/components/PillNotebook.astro';
import { findAllPublishedPills } from '@/features/pills/pill-repository';

export async function getStaticPaths() {
  const pills = await findAllPublishedPills('en');
  return pills.map(({ series, pill }) => ({ params: { series, pill } }));
}
const { series, pill } = Astro.params;
if (!series || !pill) throw new Error('Missing pill route');

---

<PillNotebook locale="en" seriesSlug={series} activePillSlug={pill} />
