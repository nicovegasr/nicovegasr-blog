---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PillSeriesList from '@/features/pills/components/PillSeriesList.astro';
import ComingSoon from '@/layouts/ComingSoon.astro';
import WritingSectionNav from '@/layouts/WritingSectionNav.astro';
import SocialLinks from '@/layouts/SocialLinks.astro';
import RepoStar from '@/layouts/RepoStar.astro';
import { getTranslator } from '@/i18n/translator';
import { buildPagePath } from '@/i18n/routes';
import { findPillSeriesCatalog } from '@/features/pills/pill-repository';

const locale = 'en';
const translate = getTranslator(locale);
const series = await findPillSeriesCatalog(locale);
---

<BaseLayout locale={locale}>
  <section class="intro reveal">
    <h1>{translate('blog.introTitle')}</h1>
    <p class="lead">
      {translate('blog.introText')}{' '}
      <a href={buildPagePath('about', locale)}>{translate('blog.introLink')}</a>
    </p>
    <SocialLinks />
    <RepoStar locale={locale} />
  </section>
  <section class="reveal">
    <WritingSectionNav locale={locale} />
    {
      series.length > 0 ? (
        <PillSeriesList locale={locale} series={series} />
      ) : (
        <ComingSoon
          heading={translate('pills.heading')}
          message={translate('pills.comingSoonText')}
        />
      )
    }
  </section>
</BaseLayout>
