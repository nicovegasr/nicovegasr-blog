---
import PostPage from '@/features/posts/PostPage.astro';
import { findHostedPosts } from '@/features/posts/post-repository';

export async function getStaticPaths() {
  const posts = await findHostedPosts('en');
  return posts.map((post) => ({ params: { slug: post.slug } }));
}
const { slug } = Astro.params;
if (!slug) throw new Error('Missing post slug');
---

<PostPage locale="en" slug={slug} />
