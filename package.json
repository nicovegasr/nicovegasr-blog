  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.64.1",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
